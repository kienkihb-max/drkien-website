# Chép file này thành ".env" (cùng thư mục) rồi điền hai giá trị lấy từ
# Supabase → Project Settings → API.
#
# Hai giá trị này công khai được — chúng nằm trong mã nguồn trang web mà ai
# xem cũng thấy. Cái giữ an toàn là phân quyền RLS trong supabase/schema.sql,
# không phải giấu khoá đi.
#
# ĐỪNG bao giờ đặt service_role key vào đây: khoá đó bỏ qua mọi phân quyền,
# lộ ra là ai cũng xoá sạch được database.
PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
PUBLIC_SUPABASE_ANON_KEY=

# Địa chỉ máy chủ trung gian của chatbot (agent-proxy trên Cloud Run), dạng
# https://chatbot-proxy-xxxxxxxxxx.us-west1.run.app — KHÔNG phải địa chỉ agent.
#
# Chỉ dùng khi build bản thật. Lúc `npm run dev` khung chat luôn gọi
# http://localhost:8099, bỏ qua dòng này. Để trống thì bản build chạy chế độ
# thử (luôn đáp câu tra_loi_thu trong src/data/chatbot.mjs).
#
# Trên Cloudflare Pages đặt riêng cho Production và Preview để thử agent mới
# ở bản xem trước mà web thật không bị ảnh hưởng. Địa chỉ này công khai
# được — ai mở trang cũng thấy; cái giữ an toàn là máy chủ trung gian chỉ
# nhận yêu cầu từ đúng tên miền của mình (ALLOWED_ORIGINS).
PUBLIC_CHATBOT_URL=
