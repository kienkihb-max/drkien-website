# Chép file này thành ".env" (cùng thư mục) rồi điền hai giá trị lấy từ
# Supabase → Project Settings → API.
#
# Hai giá trị này công khai được — chúng nằm trong mã nguồn trang web mà ai
# xem cũng thấy. Cái giữ an toàn là phân quyền RLS trong supabase/schema.sql,
# không phải giấu khoá đi.
#
# ĐỪNG bao giờ đặt service_role key vào đây: khoá đó bỏ qua mọi phân quyền,
# lộ ra là ai cũng xoá sạch được database.
PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
PUBLIC_SUPABASE_ANON_KEY=
