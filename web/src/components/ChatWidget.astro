    font-size: var(--fs-base);
    line-height: 1.4;
    color: var(--text-dark);
    background: #fff;
    box-shadow: 0 1px 4px rgba(0, 42, 106, 0.08);
    transition: border-color .2s ease, box-shadow .2s ease;
