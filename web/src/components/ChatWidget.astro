  /* Định dạng trong câu trả lời của trợ lý (đoạn, gạch đầu dòng, liên kết). */
  .chat-log :global(.chat-msg-bot) { white-space: normal; }
  .chat-log :global(.chat-msg-bot p),
  .chat-log :global(.chat-msg-bot ul),
  .chat-log :global(.chat-msg-bot ol) { margin: 0 0 8px; }
  .chat-log :global(.chat-msg-bot > :last-child) { margin-bottom: 0; }
  .chat-log :global(.chat-msg-bot ul),
