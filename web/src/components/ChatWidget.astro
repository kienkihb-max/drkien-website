    height: 7px;
    border-radius: 50%;
    background: var(--text-muted);
    animation: chat-dot 1.2s infinite ease-in-out;
  }
  .chat-log :global(.chat-typing .chat-dot:nth-child(2)) { animation-delay: .15s; }
  .chat-log :global(.chat-typing .chat-dot:nth-child(3)) { animation-delay: .3s; }
  @keyframes chat-dot {
    0%, 60%, 100% { opacity: .3; transform: translateY(0); }
    30% { opacity: 1; transform: translateY(-3px); }
  }

  .chat-suggestions {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    /* Đáy chỉ 4px: ô nhập bên dưới đã có 12px phía trên, cộng lại vừa đủ
       tách mà không để một khoảng trống lớn giữa câu gợi ý và ô nhập. */
    padding: 0 16px 4px;
    background: var(--gray-bg);
    /* Giấu phần câu gợi ý còn nằm ngoài mép lúc đang trượt vào. */
    overflow: hidden;
  }
  .chat-suggestions[hidden] { display: none; }
  .chat-chip {
    padding: 8px 14px;
    border: 1px solid var(--primary);
    border-radius: 20px;
    background: #fff;
    color: var(--primary);
    font-size: var(--fs-sm);
    font-family: inherit;
    cursor: pointer;
  }
  .chat-chip:hover { background: var(--primary-soft); }

  /* Câu gợi ý trượt vào lần lượt mỗi khi mở khung chat hoặc bắt đầu đoạn chat
     mới (script gắn lại lớp is-entering để chạy lại hiệu ứng). Mỗi câu trễ
     hơn câu trước 70ms nên trông như đang lần lượt xuất hiện. */
  .chat-suggestions.is-entering .chat-chip {
    animation: chat-chip-in .45s cubic-bezier(.2, .8, .2, 1) both;
  }
  .chat-suggestions.is-entering .chat-chip:nth-child(2) { animation-delay: 90ms; }
  .chat-suggestions.is-entering .chat-chip:nth-child(3) { animation-delay: 180ms; }
  .chat-suggestions.is-entering .chat-chip:nth-child(4) { animation-delay: 270ms; }
  .chat-suggestions.is-entering .chat-chip:nth-child(5) { animation-delay: 360ms; }
  /* Trượt nhẹ từ trái sang một đoạn ngắn (32px) kèm hiện dần — đủ để thấy
     chuyển động mà không bay ngang cả khung. overflow: hidden ở khung câu
     gợi ý giấu phần lấn ra ngoài mép lúc bắt đầu. */
  @keyframes chat-chip-in {
    from { opacity: 0; transform: translateX(-32px); }
    60% { opacity: 1; }
    to { opacity: 1; transform: none; }
  }
  /* Người đã bật "giảm chuyển động" trong máy thì hiện ngay, không trượt. */
  @media (prefers-reduced-motion: reduce) {
    .chat-suggestions.is-entering .chat-chip { animation: none; }
  }

  .chat-form {
    display: flex;
    align-items: flex-end;
    gap: 8px;
