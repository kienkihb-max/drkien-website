---
// Khung chat trợ lý AI ở góc phải dưới của mọi trang.
//
// Gắn một lần trong layouts/Trang.astro nên trang nào dùng layout đó cũng có.
// Chữ nghĩa nằm trong data/chatbot.mjs — sửa chữ ở đó, đừng sửa ở đây.
//
// Khung chat dựng sẵn phía máy chủ, chỉ phần gửi/nhận tin mới chạy ở trình
// duyệt (không thể khác: tin nhắn chỉ có sau khi người đọc gõ).
//
// Hai kiểu hiển thị (prop mode):
//   - "popup" (mặc định): nút tròn góc phải dưới, bấm mở khung chat nổi. Trên
//     điện thoại, bấm nút là chuyển sang trang /tro-ly thay vì mở khung nổi.
//   - "page": dùng riêng cho trang /tro-ly — khung chat là cả trang, không
//     có nút mở, nút đóng đưa người đọc về trang trước.
// Vì sao điện thoại dùng trang riêng: khung nổi đè lên trang web khác gặp đủ
// chuyện trên iPhone (bàn phím đẩy trang, lộ khe nhìn xuyên xuống trang phía
// sau). Một trang riêng chỉ có khung chat thì không còn gì phía sau để lộ,
// và nút Back của điện thoại tự hoạt động đúng.
import { CHATBOT } from "../data/chatbot.mjs";
import { Send, X, MessageCircle, SquarePen } from "@lucide/astro";

interface Props {
  mode?: "popup" | "page";
}
const { mode = "popup" } = Astro.props;
const isPage = mode === "page";

// Chữ mà phần chạy ở trình duyệt cần tới. Truyền qua thuộc tính data-* chứ
// không dùng define:vars, vì define:vars ép script thành inline, mất đóng gói.
//
// Lúc chạy thử trên máy (npm run dev) khung chat gọi máy chủ trung gian chạy
// ở máy luôn (agent-proxy, cổng 8099). Chỉ bản dựng thật mới dùng địa chỉ
// thật — nhờ vậy không có cách nào địa chỉ localhost lọt lên web.
//
// Bản dựng thật lấy địa chỉ theo thứ tự:
//   1. biến môi trường PUBLIC_CHATBOT_URL lúc build — Cloudflare Pages đặt
//      được giá trị khác nhau cho Production (web thật) và Preview (bản
//      xem trước), nên thử agent mới ở Preview không ảnh hưởng web thật;
//   2. dia_chi_agent trong data/chatbot.mjs;
//   3. cả hai trống → chế độ thử, luôn đáp bằng tra_loi_thu.
const DEV_PROXY = "http://localhost:8099";
const agentUrl = import.meta.env.DEV
  ? DEV_PROXY
  : (import.meta.env.PUBLIC_CHATBOT_URL || "").trim() || CHATBOT.dia_chi_agent;
const cau_hinh = JSON.stringify({
  loi_chao: CHATBOT.loi_chao,
  tra_loi_loi: CHATBOT.tra_loi_loi,
  tra_loi_thu: CHATBOT.tra_loi_thu,
  cho_tra_loi: CHATBOT.cho_tra_loi,
  dia_chi_agent: agentUrl,
});
---

<div
  class:list={["chat-widget", { "chat-widget--page is-open": isPage }]}
  data-chat
  data-mode={mode}
  data-config={cau_hinh}
>
  {!isPage && (
    <button
      type="button"
      class="chat-launcher is-peek"
      aria-expanded="false"
      aria-controls="chat-panel"
      data-chat-toggle
    >
      <MessageCircle size={26} stroke-width={2} aria-hidden="true" />
      <span class="chat-online chat-launcher-dot" aria-hidden="true"></span>
      <span class="chat-launcher-label">{CHATBOT.chu_nut_mo}</span>
    </button>
  )}

  <section
    id="chat-panel"
    class="chat-panel"
    role={isPage ? undefined : "dialog"}
    tabindex="-1"
    aria-label={CHATBOT.ten}
    hidden={!isPage}
    data-chat-panel
  >
    <header class="chat-head">
      {/* Chấm xanh ở góc ảnh đại diện: báo trợ lý luôn sẵn sàng trả lời. */}
      <span class="chat-avatar-wrap">
        <img class="chat-avatar" src="/assets/img/logo-bs-kien-mark.svg" alt="" width="40" height="40">
        <span class="chat-online" aria-hidden="true"></span>
      </span>
      <div class="chat-title">
        <strong>{CHATBOT.ten}</strong>
        <span>{CHATBOT.trang_thai}</span>
      </div>
      <button type="button" class="chat-close" aria-label="Đoạn chat mới" title="Đoạn chat mới" data-chat-new>
        <SquarePen size={20} stroke-width={2} aria-hidden="true" />
      </button>
      <button type="button" class="chat-close" aria-label={isPage ? "Quay lại trang trước" : "Đóng khung chat"} data-chat-close>
        <X size={22} stroke-width={2} aria-hidden="true" />
      </button>
    </header>

    {/* aria-live để trình đọc màn hình đọc tin mới của trợ lý khi nó tới. */}
    <div class="chat-log" aria-live="polite" data-chat-log></div>

    <div class="chat-suggestions" data-chat-suggestions>
      {CHATBOT.goi_y.map((cau) => (
        <button type="button" class="chat-chip" data-chat-chip>{cau}</button>
      ))}
    </div>

    <form class="chat-form" data-chat-form>
      <textarea
        class="chat-input"
        rows="1"
        placeholder={CHATBOT.o_nhap}
        aria-label={CHATBOT.o_nhap}
        maxlength="1000"
        data-chat-input
      ></textarea>
      <button type="submit" class="chat-send" aria-label="Gửi" data-chat-send>
        <Send size={20} stroke-width={2} aria-hidden="true" />
      </button>
    </form>
    <p class="chat-note">{CHATBOT.luu_y}</p>
  </section>
</div>

<script>
  type Role = "user" | "bot";
  type Message = { role: Role; text: string };

  const root = document.querySelector<HTMLElement>("[data-chat]");

  if (root) {
    const config = JSON.parse(root.dataset.config || "{}");
    // Chạy thử (npm run dev) và mở trang từ điện thoại qua địa chỉ Wi-Fi của
    // máy tính (192.168.x.x): "localhost" trên điện thoại là chính điện
    // thoại, nên đổi thành đúng máy đang chạy trang. Bản thật không bị ảnh
    // hưởng vì địa chỉ máy chủ ở đó không phải localhost.
    if (typeof config.dia_chi_agent === "string" && config.dia_chi_agent.startsWith("http://localhost:")) {
      config.dia_chi_agent = config.dia_chi_agent.replace("localhost", location.hostname);
    }
    // Trang chat riêng (mode "page") không có nút mở.
    const toggle = root.querySelector<HTMLButtonElement>("[data-chat-toggle]");
    const panel = root.querySelector<HTMLElement>("[data-chat-panel]")!;
    const log = root.querySelector<HTMLElement>("[data-chat-log]")!;
    const suggestions = root.querySelector<HTMLElement>("[data-chat-suggestions]")!;
    const form = root.querySelector<HTMLFormElement>("[data-chat-form]")!;
    const input = root.querySelector<HTMLTextAreaElement>("[data-chat-input]")!;
    const send = root.querySelector<HTMLButtonElement>("[data-chat-send]")!;

    // Giữ cuộc trò chuyện trong sessionStorage: người đọc bấm sang trang khác
    // rồi mở lại khung chat vẫn thấy câu hỏi cũ, nhưng đóng tab là xoá — tin
    // nhắn về sức khoẻ không nên nằm lại lâu trên máy dùng chung.
    //
    // Mọi lần đọc/ghi đều bọc try/catch: trình duyệt chặn lưu trữ (chế độ ẩn
    // danh của vài trình duyệt) thì khung chat vẫn chạy, chỉ không nhớ.
    const STORE_KEY = "chatbot-history";

    const loadHistory = (): Message[] => {
      try {
        return JSON.parse(sessionStorage.getItem(STORE_KEY) || "[]");
      } catch {
        return [];
      }
    };
    const saveHistory = (items: Message[]) => {
      try {
        sessionStorage.setItem(STORE_KEY, JSON.stringify(items));
      } catch {}
    };

    let history = loadHistory();
    let busy = false;

    const escapeHtml = (s: string) =>
      s.replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[c]!);

    /** Chữ đậm, chữ nghiêng, liên kết trong một dòng. Chạy SAU escapeHtml nên
     *  mọi thẻ HTML trong câu trả lời đã thành chữ thường, chỉ còn đúng mấy
     *  thẻ tạo ra ở đây. Liên kết chỉ nhận http/https — chặn "javascript:". */
    const renderInline = (s: string) =>
      s
        .replace(/\[([^\]]+)\]\((https?:\/\/[^\s)]+)\)/g, '<a href="$2" target="_blank" rel="noopener">$1</a>')
        .replace(/(^|[\s(])(https?:\/\/[^\s<)]+[^\s<).,;:!?])/g, '$1<a href="$2" target="_blank" rel="noopener">$2</a>')
        .replace(/\*\*(.+?)\*\*/g, "<strong>$1</strong>")
        .replace(/(^|[^*\w])\*(?!\s)(.+?)\*(?!\w)/g, "$1<em>$2</em>");

    /**
     * Đổi câu trả lời dạng markdown của agent (**đậm**, * gạch đầu dòng, ---)
     * thành HTML. Chỉ làm đủ mấy dạng agent hay dùng, không kéo cả thư viện
     * markdown về chỉ để hiện vài chữ đậm.
     */
    const renderMarkdown = (text: string) => {
      const out: string[] = [];
      let list: "ul" | "ol" | null = null;
      const closeList = () => {
        if (list) out.push(`</${list}>`);
        list = null;
      };
      for (const rawLine of escapeHtml(text).split("\n")) {
        const line = rawLine.trim();
        const bullet = line.match(/^[*-]\s+(.*)$/);
        const numbered = line.match(/^\d+[.)]\s+(.*)$/);
        if (bullet || numbered) {
          const kind = bullet ? "ul" : "ol";
          if (list !== kind) {
            closeList();
            out.push(`<${kind}>`);
            list = kind;
          }
          out.push(`<li>${renderInline((bullet || numbered)![1])}</li>`);
          continue;
        }
        closeList();
        if (!line) continue;
        if (/^(-{3,}|\*{3,})$/.test(line)) out.push("<hr>");
        else out.push(`<p>${renderInline(line.replace(/^#+\s*/, ""))}</p>`);
      }
      closeList();
      return out.join("");
    };

    /** Vẽ một bong bóng tin nhắn. Câu của người đọc hiện nguyên văn
     *  (textContent); câu của trợ lý qua renderMarkdown, vốn đã khử sạch HTML
     *  trước khi thêm định dạng — câu trả lời đến từ máy chủ ngoài, không được
     *  để nó chèn mã vào trang. */
    const addBubble = (role: Role, text: string) => {
      const el = document.createElement("div");
      el.className = "chat-msg chat-msg-" + role;
      if (role === "bot") el.innerHTML = renderMarkdown(text);
      else el.textContent = text;
      log.appendChild(el);
      log.scrollTop = log.scrollHeight;
      return el;
    };

    const showTyping = () => {
      const el = document.createElement("div");
      el.className = "chat-msg chat-msg-bot chat-typing";
      // Ba chấm nhấp nháy kèm một câu chờ: agent thường mất 5–15 giây, chỉ
      // có ba chấm thì người đọc dễ tưởng khung chat bị treo.
      el.innerHTML =
        '<span class="chat-dot"></span><span class="chat-dot"></span><span class="chat-dot"></span>' +
        '<em class="chat-typing-text"></em>';
      el.querySelector(".chat-typing-text")!.textContent = config.cho_tra_loi || "";
      log.appendChild(el);
      log.scrollTop = log.scrollHeight;
      return el;
    };

    const renderAll = () => {
      log.textContent = "";
      addBubble("bot", config.loi_chao);
      history.forEach((m) => addBubble(m.role, m.text));
      suggestions.hidden = history.length > 0;
    };

    /** Chạy lại hiệu ứng trượt vào của câu gợi ý. Gỡ lớp, ép trình duyệt vẽ
     *  lại (đọc offsetWidth), rồi gắn lại — không có bước giữa thì trình duyệt
     *  coi như lớp chưa từng bị gỡ và không chạy lại hiệu ứng. */
    const animateSuggestions = () => {
      if (suggestions.hidden) return;
      suggestions.classList.remove("is-entering");
      void suggestions.offsetWidth;
      suggestions.classList.add("is-entering");
    };

    /**
     * Gửi câu hỏi và nhận câu trả lời chảy dần: mỗi khi có thêm chữ thì gọi
     * onText(toàn bộ chữ đã nhận), để bong bóng hiện chữ ngay từ những từ
     * đầu tiên thay vì chờ cả câu.
     *
     * Chưa có địa chỉ máy chủ (dia_chi_agent trống) thì chạy chế độ thử: chờ
     * một chút cho giống thật rồi đáp bằng câu tra_loi_thu.
     *
     * Khuôn gửi/nhận: POST { message, history, stream: true } → chữ thô chảy
     * dần. Máy chủ không nhớ gì, nên lịch sử trò chuyện gửi kèm mỗi lần (máy
     * chủ chỉ đọc vài câu gần nhất). Máy chủ ở agent-proxy/ (gốc kho).
     */
    const askAgent = async (message: string, past: Message[], onText: (all: string) => void) => {
      if (!config.dia_chi_agent) {
        await new Promise((r) => setTimeout(r, 900));
        onText(config.tra_loi_thu);
        return config.tra_loi_thu;
      }
      // Hẹn giờ: quá FIRST_WORD_MS mà chưa có chữ nào về, hoặc cả câu kéo quá
      // TOTAL_MS, thì thôi chờ và hiện câu báo bận kèm Zalo. Thường câu trả
      // lời bắt đầu hiện sau 2–6 giây; chờ hơn 15 giây là người đọc bỏ đi.
      const FIRST_WORD_MS = 15000;
      const TOTAL_MS = 40000;
      const ctrl = new AbortController();
      let firstTimer = window.setTimeout(() => ctrl.abort(), FIRST_WORD_MS);
      const totalTimer = window.setTimeout(() => ctrl.abort(), TOTAL_MS);
      const gotWords = () => {
        window.clearTimeout(firstTimer);
        firstTimer = 0;
      };
      try {
        return await readReply(message, past, onText, ctrl.signal, gotWords);
      } finally {
        window.clearTimeout(firstTimer);
        window.clearTimeout(totalTimer);
      }
    };

    const readReply = async (
      message: string,
      past: Message[],
      onText: (all: string) => void,
      signal: AbortSignal,
      gotWords: () => void,
    ) => {
      const res = await fetch(config.dia_chi_agent, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ message, history: past, stream: true }),
        signal,
      });
      if (!res.ok) throw new Error("HTTP " + res.status);
      // Máy chủ chỉ gửi phản hồi khi đã có chữ đầu tiên, nên nhận được phản
      // hồi là coi như đã có chữ — tắt hẹn giờ "chờ chữ đầu tiên".
      gotWords();

      // Trình duyệt dựng sẵn trong ứng dụng khác (Zalo, Messenger, Facebook…)
      // có loại không cho đọc câu trả lời chảy dần. Khi đó chờ nhận cả câu
      // một lần rồi hiện — chậm hơn chút nhưng vẫn có câu trả lời.
      if (!res.body || typeof res.body.getReader !== "function") {
        const all = (await res.text()).trim();
        if (!all) throw new Error("Empty reply");
        gotWords();
        onText(all);
        return all;
      }

      const reader = res.body.getReader();
      const decoder = new TextDecoder();
      let all = "";
      try {
        for (;;) {
          const { done, value } = await reader.read();
          if (done) break;
          all += decoder.decode(value, { stream: true });
          if (value?.length) gotWords();
          onText(all);
        }
        all += decoder.decode();
      } catch (err) {
        // Đứt giữa chừng mà đã nhận được một đoạn thì giữ đoạn đó, còn hơn
        // xoá hết để hiện câu báo lỗi.
        if (!all.trim()) throw err;
      }
      if (!all.trim()) throw new Error("Empty reply");
      return all.trim();
    };

    const submit = async (raw: string) => {
      const text = raw.trim();
      if (!text || busy) return;

      busy = true;
      send.disabled = true;
      suggestions.hidden = true;
      input.value = "";
      autoGrow();

      const past = history.slice();
      history.push({ role: "user", text });
      saveHistory(history);
      addBubble("user", text);

      // Ba chấm chờ tới khi chữ đầu tiên về, rồi thay bằng bong bóng trả lời.
      //
      // Chữ từ máy chủ về theo từng cụm lớn, cách nhau không đều — vẽ thẳng
      // từng cụm thì chữ nhảy cục, trông giật. Nên tách hai việc: `target` là
      // toàn bộ chữ đã nhận, còn mỗi khung hình (~60 lần/giây) chỉ hiện thêm
      // vài ký tự tiến dần tới `target`, như người đang gõ. Chữ về dồn nhiều
      // thì gõ nhanh lên để không bị tụt lại quá xa.
      const typing = showTyping();
      let bubble: HTMLElement | null = null;
      let target = "";
      let shown = 0;
      let finished = false;
      let resolveDone: () => void;
      const done = new Promise<void>((r) => (resolveDone = r));

      const draw = () => {
        const remaining = target.length - shown;
        if (remaining > 0) {
          shown += Math.max(2, Math.ceil(remaining / 30));
          if (!bubble) {
            typing.remove();
            bubble = addBubble("bot", "");
          }
          bubble.innerHTML = renderMarkdown(target.slice(0, shown));
          // Chỉ tự cuộn xuống khi người đọc đang ở gần cuối, kẻo họ đang cuộn
          // lên đọc lại mà bị giật xuống liên tục.
          if (log.scrollHeight - log.scrollTop - log.clientHeight < 80) {
            log.scrollTop = log.scrollHeight;
          }
        }
        if (finished && shown >= target.length) resolveDone();
        else requestAnimationFrame(draw);
      };
      requestAnimationFrame(draw);

      let reply: string;
      try {
        reply = await askAgent(text, past, (all) => (target = all));
      } catch {
        reply = config.tra_loi_loi;
      }
      // Lỗi giữa chừng: thay hẳn phần đã hiện bằng câu báo lỗi.
      if (!reply.startsWith(target.slice(0, shown).trimEnd())) shown = 0;
      target = reply;
      finished = true;
      await done;

      history.push({ role: "bot", text: reply });
      saveHistory(history);

      busy = false;
      send.disabled = false;
      input.focus();
    };

    // Ô nhập tự cao lên theo số dòng, tới 5 dòng thì cuộn bên trong.
    const autoGrow = () => {
      input.style.height = "auto";
      input.style.height = Math.min(input.scrollHeight, 120) + "px";
    };

    const isPage = root.dataset.mode === "page";
    // Trang chat riêng cho điện thoại (src/pages/tro-ly.astro).
    const CHAT_PAGE = "/tro-ly";

    // Khung nổi chỉ còn mở trên máy tính — điện thoại đi sang trang riêng.
    const open = () => {
      panel.hidden = false;
      toggle?.setAttribute("aria-expanded", "true");
      root.classList.add("is-open");
      log.scrollTop = log.scrollHeight;
      animateSuggestions();
      input.focus();
    };

    /** Trang chat riêng: nút đóng đưa về trang người đọc vừa ở. Vào thẳng
     *  /tro-ly (gõ địa chỉ, mở từ link chia sẻ) thì không có trang trước
     *  trong site — về trang chủ. */
    const leavePage = () => {
      let cameFromSite = false;
      try {
        cameFromSite = !!document.referrer && new URL(document.referrer).origin === location.origin;
      } catch {}
      if (cameFromSite && window.history.length > 1) window.history.back();
      else location.href = "/";
    };

    const close = () => {
      if (isPage) return leavePage();
      panel.hidden = true;
      toggle?.setAttribute("aria-expanded", "false");
      root.classList.remove("is-open");
      toggle?.focus({ preventScroll: true });
    };

    // Đoạn chat mới: xoá lịch sử — máy chủ chỉ biết những gì trình duyệt gửi
    // lên, nên xoá ở đây là trợ lý quên hết các câu trước.
    const startNewChat = () => {
      if (busy) return;
      history = [];
      try {
        sessionStorage.removeItem(STORE_KEY);
      } catch {}
      renderAll();
      animateSuggestions();
      input.value = "";
      autoGrow();
      // Như lúc mở khung: trên điện thoại không tự bật bàn phím.
      if (window.matchMedia("(min-width: 768px)").matches) input.focus();
    };

    // Điện thoại: khi bàn phím bật lên, Safari (iPhone) không co khung chat
    // lại mà đẩy cả trang lên — lộ một khe trang web giữa ô nhập và bàn phím.
    // visualViewport là phần màn hình thật sự còn nhìn thấy phía trên bàn
    // phím; ép khung chat khớp đúng phần đó mỗi khi nó đổi cỡ hoặc bị cuộn.
    const isDesktop = () => window.matchMedia("(min-width: 768px)").matches;
    const fitToViewport = () => {
      const vv = window.visualViewport;
      if (!vv || panel.hidden || isDesktop()) {
        panel.style.top = panel.style.height = panel.style.bottom = "";
        return;
      }
      panel.style.top = vv.offsetTop + "px";
      panel.style.height = vv.height + "px";
      panel.style.bottom = "auto";
      log.scrollTop = log.scrollHeight;
    };
    window.visualViewport?.addEventListener("resize", fitToViewport);
    window.visualViewport?.addEventListener("scroll", fitToViewport);

    if (isPage) {
      // Trang chat riêng: khung chat đã hiện sẵn, chỉ cần khớp màn hình và
      // chạy hiệu ứng câu gợi ý. Không tự bật bàn phím trên điện thoại.
      fitToViewport();
      log.scrollTop = log.scrollHeight;
      animateSuggestions();
      if (isDesktop()) input.focus();
    }

    if (toggle) {
      // Nút mở chat hiện đủ chữ lúc mới vào, 5 giây sau thu lại thành nút
      // tròn (chỉ thấy khác trên điện thoại — máy tính luôn hiện chữ).
      window.setTimeout(() => toggle.classList.remove("is-peek"), 5000);

      toggle.addEventListener("click", () => {
        if (!isDesktop()) {
          // Quay về từ trang chat là về đúng chỗ đang đọc — việc đó do
          // ScrollMemory.astro lo chung cho mọi trang.
          location.href = CHAT_PAGE;
          return;
        }
        panel.hidden ? open() : close();
      });
    }
    root.querySelector("[data-chat-new]")!.addEventListener("click", startNewChat);
    root.querySelector("[data-chat-close]")!.addEventListener("click", close);
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && !panel.hidden) close();
    });

    form.addEventListener("submit", (e) => {
      e.preventDefault();
      submit(input.value);
    });
    // Enter là gửi, Shift+Enter là xuống dòng. Bỏ qua lúc đang gõ dấu tiếng
    // Việt bằng bộ gõ (isComposing), kẻo Enter chốt chữ lại gửi luôn câu.
    input.addEventListener("keydown", (e) => {
      if (e.key === "Enter" && !e.shiftKey && !e.isComposing) {
        e.preventDefault();
        submit(input.value);
      }
    });
    input.addEventListener("input", autoGrow);

    suggestions.querySelectorAll<HTMLButtonElement>("[data-chat-chip]").forEach((chip) => {
      chip.addEventListener("click", () => submit(chip.textContent || ""));
    });

    renderAll();
  }
</script>

<style>
  /* Tầng xếp: 150 — trên header (100) và các nút nổi (90–95) để khung chat
