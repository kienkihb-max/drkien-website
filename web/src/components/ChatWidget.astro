    }
    .chat-note { padding-bottom: calc(12px + env(safe-area-inset-bottom, 0px)); }
  }

  /* Trang chat riêng /tro-ly: khung chat là cả trang, ở mọi khổ màn hình. */
  .chat-widget--page {
