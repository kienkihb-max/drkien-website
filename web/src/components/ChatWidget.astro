    }
    /* Điện thoại: mới vào trang thì nút hiện đủ chữ cho người đọc biết đây
       là gì, sau 5 giây thu lại thành nút tròn để khỏi che nội dung (lớp
       is-peek do script bên trên gỡ). Chữ co bằng max-width chứ không bằng
       display: none, để có đường thu lại mượt và trình đọc màn hình vẫn đọc
       được nhãn nút. */
    .chat-launcher {
      min-width: 56px;
      padding: 0 15px;
      gap: 0;
      justify-content: center;
    }
    .chat-launcher-label {
      max-width: 0;
      overflow: hidden;
