  /* Khung nhận focus khi mở trên điện thoại (thay cho ô nhập) — không cần viền. */
  .chat-panel:focus { outline: none; }

  .chat-head {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 14px 12px 14px 16px;
    background: var(--primary);
