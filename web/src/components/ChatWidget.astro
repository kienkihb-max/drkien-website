    /* Nhường chỗ cho thanh nút liên hệ dính đáy (trang dịch vụ) và nút nổi
       giữa đáy khi đọc bài — không thì nút chat đè lên chúng. */
    :global(body.sticky-cta-on) .chat-widget { bottom: calc(16px + 76px); }
    :global(body:has(.cta-noi:not(.an))) .chat-widget { bottom: calc(16px + 64px); }

    /* Khung chat phủ kín màn hình, như mở một ứng dụng nhắn tin. */
