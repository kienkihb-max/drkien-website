---
// Header + thanh điều hướng dùng chung cho toàn site.
// Thêm/bớt mục menu ở đây là đổi đồng thời trên tất cả các trang.
//
// Chuyển từ site-header.js sang. Khác biệt: menu được in thẳng vào HTML lúc
// build thay vì do JS dựng lúc chạy, nên Google thấy được toàn bộ liên kết
// nội bộ ngay từ lần đọc đầu — trước đây nó phải chạy JS mới thấy.
import { ZALO } from "../data/thong-tin.mjs";

interface Props {
  /** Tên trang hiện tại, dạng slug không đuôi: "blog", "dieu-tri"… */
  trang?: string;
}
import { DICH_VU } from "../data/dich-vu.mjs";
import { HeartPulse, Presentation, Stethoscope } from "@lucide/astro";

// Khai từng icon một chứ không nhập cả bộ Lucide: nhập cả bộ là kéo theo
// hơn 1800 icon vào lúc dựng. Thêm dịch vụ mới thì thêm một dòng ở đây cho
// khớp trường icon trong dich-vu.mjs.
const ICON = { HeartPulse, Presentation, Stethoscope };

const { trang = "" } = Astro.props;
const la_trang_chu = trang === "" || trang === "index";

// Trên trang chủ neo thẳng tới section; ở trang con phải quay về "/" trước.
const toiTrangChu = (neo: string) => (la_trang_chu ? neo : "/" + neo);

// Tên dịch vụ lấy từ data/dich-vu.mjs — nguồn duy nhất cho toàn site.
// Đừng rút gọn lại cho vừa menu: ba chỗ tự đặt tên ngắn khác nhau chính
// là thứ đã làm người đọc tưởng có nhiều dịch vụ hơn thực tế.
const MUC_DICH_VU = DICH_VU.map((d) => ({
  trang: d.duong_dan,
  chu: d.ten,
  Icon: ICON[d.icon],
}));
---

<header class="site-header" id={la_trang_chu ? "top" : undefined}>
  <div class="container header-inner">
    <a href={la_trang_chu ? "#top" : "/"} class="brand">
      <!-- Bản rút gọn (không vòng chữ): ô logo chỉ 44px, ở cỡ đó vòng chữ
           thành vệt mờ. Bản đầy đủ là assets/img/logo-bs-kien.svg. -->
      <img class="brand-mark" src="/assets/img/logo-bs-kien-mark.svg" alt="Logo Chạy bộ cùng bác sĩ Kiên">
      <span class="brand-text">ThS.BS Lê Trung Kiên</span>
    </a>
    <button class="nav-toggle" id="navToggle" aria-label="Mở menu" aria-expanded="false">
      <span></span><span></span><span></span>
    </button>
    <nav class="site-nav" id="siteNav">
      <a href={la_trang_chu ? "#top" : "/"}>Trang chủ</a>
      <div class="nav-dropdown">
        <a href={toiTrangChu("#offerings")}>
          Dịch vụ
          <svg class="icon icon-sm nav-dropdown-arrow"><use href="#ic-chevron-down"/></svg>
        </a>
        <div class="nav-dropdown-menu">
          {MUC_DICH_VU.map((m) => (
            <a href={m.trang}>
              {m.Icon && <m.Icon size={17} stroke-width={1.8} />}
              {m.chu}
            </a>
          ))}
        </div>
      </div>
      <!-- Sản phẩm để riêng chứ không nhét vào menu xổ xuống "Dịch vụ":
           ba mục trong đó là việc mình làm cho người bệnh, còn đây là đồ
           bán. Gộp chung thì câu "Mình có thể giúp bạn…" trên thẻ dịch vụ
           trang chủ sẽ lạc nghĩa ngay ở mục thứ tư. -->
      <a href="/san-pham">Sản phẩm</a>
      <a href="/bac-si-le-trung-kien">Giới thiệu</a>
      <a href="/blog">Blog</a>
      <a href={ZALO} target="_blank" rel="noopener" class="nav-cta">Liên hệ</a>
    </nav>
  </div>
</header>

<script>
  // Nút hamburger trên mobile. Đây là phần duy nhất của header thật sự cần
  // JS — còn lại đã là HTML sẵn.
  const nut = document.getElementById("navToggle");
  const menu = document.getElementById("siteNav");
  if (nut && menu) {
    nut.addEventListener("click", () => {
      const dang_mo = menu.classList.toggle("open");
      nut.setAttribute("aria-expanded", String(dang_mo));
    });
    menu.querySelectorAll("a").forEach((lien_ket) => {
      lien_ket.addEventListener("click", () => {
        menu.classList.remove("open");
        nut.setAttribute("aria-expanded", "false");
      });
    });
  }
</script>
