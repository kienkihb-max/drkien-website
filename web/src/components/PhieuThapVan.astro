---
// Biểu mẫu "Phiếu Thập Vấn Chuyên Khoa" cho bệnh nhân điền trên điện thoại.
// Nội dung câu hỏi ở data/phieu-thap-van.mjs; file này lo khung trang, giao
// diện và phần chạy phía trình duyệt (rẽ nhánh, kiểm tra, nén ảnh, gửi).
//
// Trang CHỈ ghi lại câu trả lời nguyên văn — không tính điểm, không phân
// thể, không gợi ý chẩn đoán. Đừng thêm bất cứ logic nào kiểu đó vào đây:
// mọi thứ trong file này đều gửi xuống trình duyệt của người xem.
//
// Vì sao form dựng sẵn ở build mà không để JS vẽ: mọi phần đều có trong
// HTML (phần chưa tới thì `hidden`), script chỉ bật/tắt và kiểm tra. Cùng
// cách với Header, và lỗi script không làm trắng cả trang.
import {
  PHAN_VAN_DE,
  PHAN_LIEN_HE,
  BO_CHUYEN_KHOA,
  BO_PHU_KHOA,
  CANH_BAO,
  PHAN_THAP_VAN,
  GIOI_TINH_NU,
  PHAN_KINH_NGUYET,
  PHAN_ANH_LUOI,
  DA_GUI,
} from "../data/phieu-thap-van.mjs";
import PhieuCauHoi from "./PhieuCauHoi.astro";
// Giao diện dùng chung với trang admin xem lại phiếu (chế độ chỉ đọc): sửa ở file
// CSS này là đổi cả hai nơi.
import "./phieu-giao-dien.css";

// Địa chỉ Google Apps Script nhận phiếu (xem web/apps-script/HUONG-DAN.md).
// Địa chỉ này công khai được: nó chỉ nhận dữ liệu gửi vào, không có đường
// nào đọc ngược ra. Chưa đặt thì form báo lỗi khi gửi chứ không giả vờ đã gửi.
const diem_nhan = import.meta.env.PUBLIC_PHIEU_URL ?? "";

// Hai nơi dùng chung form này:
//  - "benh-nhan" (mặc định): trang /sang-loc-benh, bệnh nhân tự điền.
//  - "admin": nằm trong panel của trang quản trị để bác sĩ nhập hộ. Khác ở
//    chỗ: không chống bot (người đã đăng nhập), không đụng history của trình
//    duyệt (form chỉ là một khung trên trang), không lưu nháp (máy bác sĩ,
//    dữ liệu bệnh nhân người khác), gửi xong thì báo cho trang cha qua sự kiện,
//    và phát "phieu:thay-doi" mỗi lần đổi câu để trang cha chấm điểm realtime.
interface Props {
  che_do?: "benh-nhan" | "admin";
}
const { che_do = "benh-nhan" } = Astro.props;
const la_admin = che_do === "admin";

const NAM_NAY = new Date().getFullYear();
---

<div
  class="phieu"
  id="phieu"
  data-che-do={che_do}
  data-diem-nhan={diem_nhan}
  data-bo-phu-khoa={BO_PHU_KHOA}
  data-nu={GIOI_TINH_NU}
  data-nam-nay={NAM_NAY}
  data-da-gui-tieu-de={DA_GUI.tieu_de}
  data-da-gui-noi-dung={DA_GUI.noi_dung}
>
  <form id="phieuForm" novalidate autocomplete="off">
    <!-- Ô bẫy bot: người thật không thấy nên không điền, bot điền hết mọi ô
         thấy được. Có chữ trong đây là bỏ phiếu. -->
    {!la_admin && (
      <div class="phieu-bay" aria-hidden="true">
        <label>Để trống ô này <input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
      </div>
    )}

    <!-- Phần 1 · Vấn đề + chuyên khoa -->
    <section class="phan" data-phan="vande" data-ten={PHAN_VAN_DE.ten}>
      <div class="the the-dau">
        <h2>{PHAN_VAN_DE.tieu_de}</h2>
      </div>
      {PHAN_VAN_DE.cau_hoi.map((c: any) => <PhieuCauHoi c={c} phan={PHAN_VAN_DE.ten} />)}
    </section>

    <!-- Phần 2 · Mỗi chuyên khoa một bộ, chỉ hiện đúng bộ bệnh nhân chọn -->
    {Object.entries(BO_CHUYEN_KHOA).map(([ma, bo]: [string, any]) => (
      <section class="phan" data-phan={"bo-" + ma} data-ten={bo.ten} hidden>
        <div class="the the-dau">
          <h2>{bo.tieu_de ?? bo.ten}</h2>
        </div>
        {bo.cau_hoi.map((c: any) => <PhieuCauHoi c={c} phan={bo.ten} />)}
      </section>
    ))}

    <!-- Trang Cảnh báo -->
    <section class="phan" data-phan="canhbao" data-ten="Cảnh báo" hidden>
      <div class="the the-canh-bao" role="alert">
        <h2>{CANH_BAO.tieu_de}</h2>
        <p class="canh-bao-nho">{CANH_BAO.tieu_de_nho}</p>
        <ul>
          {CANH_BAO.y.map((y: string) => <li>{y}</li>)}
        </ul>
      </div>
    </section>

    <!-- Phần 3 · Thập vấn chung -->
    <section class="phan" data-phan="thapvan" data-ten={PHAN_THAP_VAN.ten} hidden>
      <div class="the the-dau">
        <h2>{PHAN_THAP_VAN.tieu_de}</h2>
      </div>
      {PHAN_THAP_VAN.cau_hoi.map((c: any) => <PhieuCauHoi c={c} phan={PHAN_THAP_VAN.ten} />)}
    </section>

    <!-- Phần 4 · Kinh nguyệt -->
    <section class="phan" data-phan="kinhnguyet" data-ten={PHAN_KINH_NGUYET.ten} hidden>
      <div class="the the-dau">
        <h2>{PHAN_KINH_NGUYET.tieu_de}</h2>
      </div>
      {PHAN_KINH_NGUYET.cau_hoi.map((c: any) => <PhieuCauHoi c={c} phan={PHAN_KINH_NGUYET.ten} />)}
    </section>

    <!-- Phần 5 · Ảnh lưỡi -->
    <section class="phan" data-phan="luoi" data-ten={PHAN_ANH_LUOI.ten} hidden>
      <div class="the the-dau">
        <h2>{PHAN_ANH_LUOI.tieu_de}</h2>
      </div>
      <div class="the huong-dan">
        <h3>{PHAN_ANH_LUOI.huong_dan_tieu_de}</h3>
        <ul>
          {PHAN_ANH_LUOI.huong_dan.map((h: any) => (
            <li>
              <span class={"huong-dan-nhan " + (h.nen ? "nen" : "khong")} aria-hidden="true">{h.nen ? "✓" : "✕"}</span>
              <span>{h.chu}</span>
            </li>
          ))}
        </ul>
      </div>
      {PHAN_ANH_LUOI.cau_hoi.map((c: any) => <PhieuCauHoi c={c} phan={PHAN_ANH_LUOI.ten} />)}
    </section>

    <!-- Phần 6 · Thông tin liên hệ (cuối cùng, ngay trước nút Gửi) -->
    <section class="phan" data-phan="lienhe" data-ten={PHAN_LIEN_HE.ten} hidden>
      <div class="the the-dau">
        <h2>{PHAN_LIEN_HE.tieu_de}</h2>
      </div>
      {PHAN_LIEN_HE.cau_hoi.map((c: any) => <PhieuCauHoi c={c} phan={PHAN_LIEN_HE.ten} />)}
    </section>

    <!-- Màn hình sau khi gửi -->
    <section class="phan" data-phan="xong" hidden>
      <div class="the the-xong" role="status">
        <h2 id="xongTieuDe"></h2>
        <p id="xongNoiDung"></p>
        {!la_admin && <button type="button" class="btn btn-outline" id="lamLai">Làm lại phiếu</button>}
      </div>
    </section>

    <p class="phieu-loi-gui" id="loiGui" role="alert" hidden></p>

  </form>

  <!-- Thanh dính ở đáy màn hình: tiến độ + nút Quay lại / Tiếp luôn nằm trong
       tầm ngón cái, bệnh nhân khỏi phải cuộn xuống cuối phần mới bấm được. -->
  <div class="phieu-chan" id="phieuChan">
    <div class="phieu-tien-do" aria-live="polite">
      <p class="phieu-tien-do-chu" id="tienDoChu">Phần 1 / 6</p>
      <div class="phieu-tien-do-nen" aria-hidden="true"><div class="phieu-tien-do-thanh" id="tienDoThanh" style="width:16.67%"></div></div>
    </div>
    <div class="phieu-dieu-huong" id="dieuHuong">
      <button type="button" class="btn btn-outline" id="nutLui" hidden>Quay lại</button>
      <button type="button" class="btn btn-primary" id="nutTiep">Tiếp</button>
    </div>
  </div>
</div>

<script>
  import { nenAnh, blobSangBase64, guiVaoSupabase } from "../lib/gui-phieu";

  // ---- Phần chạy phía trình duyệt ------------------------------------------
  // Trang này không biết gì về thể bệnh: chỉ (1) quyết định phần nào hiện
  // tiếp theo, (2) chặn khi còn câu bắt buộc chưa trả lời, (3) gom câu trả
  // lời nguyên văn gửi về Google Sheet.

  const goc = document.getElementById("phieu") as HTMLElement;
  const form = document.getElementById("phieuForm") as HTMLFormElement;
  const nutTiep = document.getElementById("nutTiep") as HTMLButtonElement;
  const nutLui = document.getElementById("nutLui") as HTMLButtonElement;
  const loiGui = document.getElementById("loiGui") as HTMLElement;
  const chuTienDo = document.getElementById("tienDoChu") as HTMLElement;
  const thanhTienDo = document.getElementById("tienDoThanh") as HTMLElement;

  const BO_PHU_KHOA = goc.dataset.boPhuKhoa!;
  const GIOI_NU = goc.dataset.nu!;
  const NAM_NAY = Number(goc.dataset.namNay);
  const DIEM_NHAN = goc.dataset.diemNhan ?? "";
  // Đọc từ data-che-do chứ không đoán theo URL: cùng một form, hai nơi dùng.
  const LA_ADMIN = goc.dataset.cheDo === "admin";

  // Header cố định phía trên: các lần cuộn tự động phải chừa chỗ cho nó.
  const header = document.querySelector<HTMLElement>(".site-header");

  // Ở chế độ admin form nằm trong hộp thoại có thanh cuộn riêng; window không
  // cuộn được gì. Tìm tổ tiên đang cuộn để đưa nó về đầu.
  // Trang cha có thể chỉ định thẳng bộ chứa cuộn bằng data-bo-cuon (panel của trang
  // admin): chắc hơn đoán, vì khi nội dung chưa tràn thì không tổ tiên nào "đang cuộn".
  function boChuaCuon(): HTMLElement | null {
    const chi_dinh = goc.closest<HTMLElement>("[data-bo-cuon]");
    if (chi_dinh) return chi_dinh;
    for (let e = goc.parentElement; e; e = e.parentElement) {
      const oy = getComputedStyle(e).overflowY;
      if ((oy === "auto" || oy === "scroll") && e.scrollHeight > e.clientHeight) return e;
    }
    return null;
  }

  const phanEl = (ma: string) => form.querySelector<HTMLElement>(`[data-phan="${ma}"]`)!;
  // Đáp án "Khác" ghi kèm chữ bệnh nhân gõ: "Khác: đau mông". Chưa gõ gì thì
  // chỉ ghi "Khác".
  const giaTriChon = (ten: string): string[] =>
    [...form.querySelectorAll<HTMLInputElement>(`input[name="${ten}"]:checked`)].map((o) => {
      if (!o.dataset.khac) return o.value;
      const chu = form.querySelector<HTMLInputElement>(`input[name="${ten}__khac"]`)?.value.trim();
      return chu ? "Khác: " + chu : "Khác";
    });

  // Phần nào ứng với "Phần x / 6" trên thanh tiến độ.
  const SO_PHAN: Record<string, number> = {
    vande: 1, canhbao: 2, thapvan: 3, kinhnguyet: 4, luoi: 5, lienhe: 6,
  };

  function maBo(): string {
    const chon = form.querySelector<HTMLInputElement>('input[name="chuyen_khoa"]:checked');
    return chon?.dataset.bo ?? "";
  }

  function coDauHieuNguyHiem(): boolean {
    const bo = maBo();
    if (!bo) return false;
    const q = phanEl("bo-" + bo).querySelector<HTMLElement>('.q[data-nguy-hiem="1"]');
    return !!q && giaTriChon(q.dataset.id!).includes("Có");
  }

  // Đường đi hiện tại, tính lại mỗi lần bấm vì đáp án trước đổi thì đường đổi.
  function duongDi(): string[] {
    const duong = ["vande"];
    const bo = maBo();
    if (bo) {
      duong.push("bo-" + bo);
      if (coDauHieuNguyHiem()) duong.push("canhbao");
    }
    duong.push("thapvan");
    if (giaTriChon("gioi_tinh")[0] === GIOI_NU && bo !== BO_PHU_KHOA) duong.push("kinhnguyet");
    duong.push("luoi", "lienhe");
    return duong;
  }

  let hienTai = "vande";

  function hienPhan(ma: string, cuon = true) {
    form.querySelectorAll<HTMLElement>(".phan").forEach((p) => (p.hidden = p.dataset.phan !== ma));
    hienTai = ma;
    loiGui.hidden = true;

    const xong = ma === "xong";
    nutLui.hidden = xong || duongDi().indexOf(ma) <= 0;
    document.getElementById("phieuChan")!.hidden = xong;
    nutTiep.textContent = ma === "lienhe" ? "Gửi phiếu" : "Tiếp";

    const so = ma.startsWith("bo-") ? 2 : SO_PHAN[ma];
    if (xong) {
      chuTienDo.textContent = "Hoàn tất";
      thanhTienDo.style.width = "100%";
    } else {
      chuTienDo.textContent = `Phần ${so} / 6`;
      thanhTienDo.style.width = (so / 6) * 100 + "%";
    }
    // Đưa focus về tiêu đề phần mới để người dùng bàn phím/đọc màn hình
    // không bị bỏ lại ở nút Tiếp của phần cũ.
    const tieu_de = phanEl(ma).querySelector<HTMLElement>("h2");
    if (tieu_de && cuon) {
      tieu_de.tabIndex = -1;
      tieu_de.focus({ preventScroll: true });
    }
    if (cuon && LA_ADMIN) {
      const bo = boChuaCuon();
      if (bo) bo.scrollTop = 0;
    } else if (cuon) {
      // Cuộn về đầu phiếu, chừa chỗ cho header cố định phía trên.
      const chua = header?.offsetHeight ?? 84;
      const y = goc.getBoundingClientRect().top + window.scrollY - chua;
      window.scrollTo({ top: Math.max(0, y) });
    }
  }

  // ---- Kiểm tra câu bắt buộc ----
  const dsAnh: File[] = [];

  function traLoiRoi(q: HTMLElement): boolean {
    const id = q.dataset.id!;
    switch (q.dataset.loai) {
      case "chon1":
      case "chon_nhieu":
      case "thang":
        return giaTriChon(id).length > 0;
      case "anh":
        return dsAnh.length > 0;
      default: {
        const o = q.querySelector<HTMLInputElement | HTMLTextAreaElement>("input,textarea")!;
        return o.value.trim() !== "";
      }
    }
  }

  // Ngoài "không để trống", vài ô cần đúng dạng: năm sinh và số điện thoại.
  function loiDinhDang(q: HTMLElement): string {
    const id = q.dataset.id;
    const khac = q.querySelector<HTMLInputElement>("input[data-khac]:checked");
    if (khac && !q.querySelector<HTMLInputElement>(".q-khac")!.value.trim()) return "Vui lòng điền ô Khác";
    const v = (q.querySelector<HTMLInputElement>("input")?.value ?? "").trim();
    if (id === "nam_sinh" && !(Number(v) >= 1900 && Number(v) <= NAM_NAY)) return "Vui lòng nhập năm sinh gồm 4 chữ số, ví dụ 1985";
    if (id === "sdt" && !/^\d{9,11}$/.test(v)) return "Vui lòng nhập số điện thoại gồm 9–11 chữ số";
    return "";
  }

  function kiemTraPhan(ma: string): boolean {
    let dau_tien: HTMLElement | null = null;
    phanEl(ma).querySelectorAll<HTMLElement>(".q").forEach((q) => {
      const loi = q.querySelector<HTMLElement>(".q-loi")!;
      let chu = "";
      if (q.dataset.batBuoc) {
        chu = traLoiRoi(q) ? loiDinhDang(q) : "Vui lòng điền thông tin";
      }
      q.classList.toggle("q-thieu", chu !== "");
      loi.hidden = chu === "";
      if (chu) loi.textContent = chu;
      if (chu && !dau_tien) dau_tien = q;
    });
    if (dau_tien) {
      (dau_tien as HTMLElement).scrollIntoView({ block: "center", behavior: "smooth" });
      return false;
    }
    return true;
  }

  // Chọn "Khác" thì hiện ô gõ chữ (và đưa con trỏ vào đó); chọn đáp án khác
  // trong câu chọn một thì ẩn lại.
  form.addEventListener("change", (e) => {
    const q = (e.target as HTMLElement).closest<HTMLElement>(".q");
    const o_khac = q?.querySelector<HTMLInputElement>(".q-khac");
    const nut_khac = q?.querySelector<HTMLInputElement>("input[data-khac]");
    if (!q || !o_khac || !nut_khac) return;
    const dang_chon = nut_khac.checked;
    o_khac.hidden = !dang_chon;
    if (dang_chon && e.target === nut_khac) o_khac.focus();
  });

  // Gỡ viền đỏ ngay khi người dùng trả lời xong câu đó.
  form.addEventListener("input", (e) => {
    const q = (e.target as HTMLElement).closest<HTMLElement>(".q");
    if (q?.classList.contains("q-thieu") && traLoiRoi(q) && !loiDinhDang(q)) {
      q.classList.remove("q-thieu");
      q.querySelector<HTMLElement>(".q-loi")!.hidden = true;
    }
  });

  // Ô "Số" chỉ nhận chữ số.
  form.querySelectorAll<HTMLInputElement>('.q[data-loai="so"] input').forEach((o) =>
    o.addEventListener("input", () => (o.value = o.value.replace(/\D/g, ""))),
  );

  // ---- Ảnh lưỡi ----
  const khungAnh = form.querySelector<HTMLElement>(".q-anh")!;
  const oFile = khungAnh.querySelector<HTMLInputElement>('input[type="file"]')!;
  const dsHienAnh = khungAnh.querySelector<HTMLElement>(".q-anh-ds")!;
  const TOI_DA = Number(khungAnh.dataset.toiDa);
  const MB_TOI_DA = Number(khungAnh.dataset.mbToiDa);
  const qAnh = khungAnh.closest<HTMLElement>(".q")!;

  function baoLoiAnh(chu: string) {
    const loi = qAnh.querySelector<HTMLElement>(".q-loi")!;
    qAnh.classList.add("q-thieu");
    loi.textContent = chu;
    loi.hidden = false;
  }

  function veDsAnh() {
    dsHienAnh.replaceChildren();
    dsAnh.forEach((f, i) => {
      const li = document.createElement("li");
      const img = document.createElement("img");
      img.alt = "";
      img.src = URL.createObjectURL(f);
      img.onload = () => URL.revokeObjectURL(img.src);
      const ten = document.createElement("span");
      ten.className = "anh-ten";
      ten.textContent = f.name;
      const xoa = document.createElement("button");
      xoa.type = "button";
      xoa.textContent = "Xóa";
      xoa.setAttribute("aria-label", "Xóa ảnh " + (i + 1));
      xoa.addEventListener("click", () => {
        dsAnh.splice(i, 1);
        veDsAnh();
        // Xóa bớt ảnh là đã gỡ được lý do báo lỗi "Tối đa 3 ảnh".
        if (dsAnh.length) {
          qAnh.classList.remove("q-thieu");
          qAnh.querySelector<HTMLElement>(".q-loi")!.hidden = true;
        }
      });
      li.append(img, ten, xoa);
      dsHienAnh.append(li);
    });
  }

  oFile.addEventListener("change", () => {
    let loi = "";
    for (const f of oFile.files ?? []) {
      if (!f.type.startsWith("image/")) loi = "Vui lòng chọn tệp ảnh";
      else if (f.size > MB_TOI_DA * 1024 * 1024) loi = `Vui lòng chọn ảnh nhỏ hơn ${MB_TOI_DA}MB`;
      else if (dsAnh.length >= TOI_DA) loi = `Vui lòng chỉ chọn tối đa ${TOI_DA} ảnh`;
      else dsAnh.push(f);
    }
    oFile.value = ""; // cho phép chọn lại đúng tệp vừa xóa
    veDsAnh();
    if (loi) baoLoiAnh(loi);
    else if (dsAnh.length) {
      qAnh.classList.remove("q-thieu");
      qAnh.querySelector<HTMLElement>(".q-loi")!.hidden = true;
    }
  });

  // ---- Gửi phiếu ----
  const thoiDiemMo = Date.now();

  function gomCauTraLoi(duong: string[]) {
    const cot: { ma: string; tieu_de: string; gia_tri: string }[] = [];
    for (const ma of duong) {
      phanEl(ma).querySelectorAll<HTMLElement>(".q").forEach((q) => {
        const loai = q.dataset.loai;
        let gia_tri = "";
        if (loai === "anh") gia_tri = ""; // link Drive do script điền
        else if (loai === "chon1" || loai === "chon_nhieu" || loai === "thang")
          gia_tri = giaTriChon(q.dataset.id!).join(" | ");
        else gia_tri = q.querySelector<HTMLInputElement>("input,textarea")!.value.trim();
        cot.push({ ma: q.dataset.id!, tieu_de: q.dataset.cot!, gia_tri });
      });
    }
    return cot;
  }

  // ---- Báo thay đổi cho trang cha (chỉ chế độ admin) ----
  // Trang admin nghe để chấm điểm realtime theo từng lần bấm. Dùng lại đúng
  // gomCauTraLoi/duongDi nên dạng dữ liệu y hệt lúc gửi lên Supabase (không có
  // câu ảnh). Gom 150ms vì gõ chữ phát input liên tục, chấm điểm mỗi phím là phí.
  let hen_bao: number | undefined;
  function baoThayDoi() {
    if (!LA_ADMIN) return;
    clearTimeout(hen_bao);
    hen_bao = window.setTimeout(() => {
      const chuyen_khoa =
        form.querySelector<HTMLInputElement>('input[name="chuyen_khoa"]:checked')?.value ?? null;
      const cau_tra_loi = gomCauTraLoi(duongDi()).filter((c) => c.ma !== qAnh.dataset.id);
      goc.dispatchEvent(new CustomEvent("phieu:thay-doi", { bubbles: true, detail: { chuyen_khoa, cau_tra_loi } }));
    }, 150);
  }
  if (LA_ADMIN) {
    form.addEventListener("input", baoThayDoi);
    form.addEventListener("change", baoThayDoi);
  }

  async function guiPhieu() {
    // Ô bẫy bị điền, hoặc phiếu "điền xong" trong vài giây: là bot. Giả vờ
    // thành công để bot không biết đường mà né.
    // Chế độ admin: người đã đăng nhập nhập hộ, không có ô bẫy và không bị
    // chặn "điền quá nhanh".
    if (!LA_ADMIN) {
      const bay = form.querySelector<HTMLInputElement>('input[name="website"]')!.value;
      if (bay || Date.now() - thoiDiemMo < 8000) return hienXong();
    }

    const ho_ten = form.querySelector<HTMLInputElement>('[name="ho_ten"]')!.value.trim();
    const nam_sinh = form.querySelector<HTMLInputElement>('[name="nam_sinh"]')!.value.trim();
    const sdt = form.querySelector<HTMLInputElement>('[name="sdt"]')!.value.trim();
    const cot = gomCauTraLoi(duongDi());

    // Nén một lần, dùng cho cả hai nơi nhận. Lỗi nén (ảnh hỏng) báo thẳng
    // cho bệnh nhân chọn ảnh khác, không đem đi thử nơi nhận phụ.
    const anh = await Promise.all(dsAnh.map(nenAnh));

    // Nơi lưu chính: Supabase. Ảnh đã nằm trong kho riêng nên không đưa lại
    // vào câu trả lời; câu ảnh bỏ khỏi cau_tra_loi.
    const phieu = {
      id: crypto.randomUUID(),
      ho_ten,
      nam_sinh: /^\d+$/.test(nam_sinh) ? Number(nam_sinh) : null,
      sdt,
      // Chữ đáp án chuyên khoa nguyên văn (value của ô radio đang chọn).
      chuyen_khoa:
        form.querySelector<HTMLInputElement>('input[name="chuyen_khoa"]:checked')?.value ?? null,
      cau_tra_loi: cot.filter((c) => c.ma !== qAnh.dataset.id),
    };
    try {
      await guiVaoSupabase(phieu, anh);
    } catch {
      // Supabase hỏng (mạng, DB chưa dựng...): thử đường cũ. Apps Script nhận
      // được thì bác sĩ vẫn thấy phiếu ở Google Sheet nên coi là đã gửi.
      if (!(await guiApps(cot, anh, ho_ten, nam_sinh))) {
        throw new Error("Vui lòng thử lại hoặc nhắn Zalo cho bác sĩ, chưa gửi được phiếu.");
      }
      // Chỉ lưu được ở Google Sheet: không có id trong Supabase để báo ra.
      return hienXong();
    }

    // Đã lưu xong: hiện màn "Đã gửi" ngay, bản sao Google Sheet chạy nền,
    // không chờ và nuốt lỗi (nếu hỏng thì bản chính vẫn nằm ở Supabase).
    void guiApps(cot, anh, ho_ten, nam_sinh);
    hienXong(phieu.id);
  }

  // Gửi sang Google Apps Script. Trả true khi script báo ok; mọi lỗi (chưa
  // đặt địa chỉ, mạng, trả lời lạ) đều thành false chứ không ném ra.
  async function guiApps(
    cot: { ma: string; tieu_de: string; gia_tri: string }[],
    anh_nen: Blob[],
    ho_ten: string,
    nam_sinh: string,
  ): Promise<boolean> {
    if (!DIEM_NHAN) return false;
    try {
      const anh = await Promise.all(
        anh_nen.map(async (b, i) => ({
          ma: qAnh.dataset.id!,
          ten: `anh-luoi-${i + 1}.jpg`,
          mime: "image/jpeg",
          du_lieu: await blobSangBase64(b),
        })),
      );
      // Họ tên và năm sinh gửi riêng để script đặt tên file ảnh; không dựa vào
      // chữ câu hỏi (chữ này sẽ đổi khi chủ site sửa câu hỏi).
      const goi = { cot, anh, ho_ten, nam_sinh };
      // text/plain để là "yêu cầu đơn giản": Apps Script không trả lời được
      // bước hỏi dò (preflight) của trình duyệt, gửi application/json là hỏng.
      const tra_loi = await fetch(DIEM_NHAN, {
        method: "POST",
        headers: { "Content-Type": "text/plain;charset=utf-8" },
        body: JSON.stringify(goi),
      });
      const kq = await tra_loi.json();
      return kq?.ok === true;
    } catch {
      return false;
    }
  }

  function hienXong(id?: string) {
    // Chế độ admin: không có màn "Đã gửi" cho bệnh nhân; báo cho trang cha
    // (nó đóng hộp thoại, nạp lại danh sách rồi gửi "phieu:dat-lai" để xóa form).
    if (LA_ADMIN) {
      goc.dispatchEvent(new CustomEvent("phieu:da-gui", { bubbles: true, detail: { id: id ?? null } }));
      return;
    }
    const ten = form.querySelector<HTMLInputElement>('[name="ho_ten"]')!.value.trim();
    const sdt = form.querySelector<HTMLInputElement>('[name="sdt"]')!.value.trim();
    document.getElementById("xongTieuDe")!.textContent = goc.dataset.daGuiTieuDe!;
    // textContent chứ không innerHTML: họ tên là chữ người lạ gõ vào.
    // Thay trong MỘT lượt bằng hàm: tên người gõ có dấu đô-la hay {sdt} thì
    // không bị hiểu thành mẫu thay thế.
    document.getElementById("xongNoiDung")!.textContent = goc.dataset.daGuiNoiDung!.replace(
      /\{(ten|sdt)\}/g,
      (_, k: string) => (k === "ten" ? ten : sdt),
    );
    xoaNhap();
    hienPhan("xong");
  }

  // ---- Nút điều hướng ----
  nutTiep.addEventListener("click", async () => {
    // Trang Cảnh báo không có câu hỏi nên luôn qua được bước kiểm tra.
    if (!kiemTraPhan(hienTai)) return;
    const duong = duongDi();
    const ke = duong[duong.indexOf(hienTai) + 1];
    if (ke) {
      hienPhan(ke);
      // Mỗi phần là một mục trong lịch sử trình duyệt: nút Back của điện
      // thoại lùi về phần trước thay vì thoát khỏi phiếu. Chế độ admin không
      // đụng history: form chỉ là hộp thoại, Back phải rời trang admin như thường.
      if (!LA_ADMIN) {
        buoc += 1;
        history.pushState({ phan: ke, i: buoc }, "");
      }
      luuNhap();
      return;
    }

    // Đang ở phần cuối: gửi.
    nutTiep.disabled = true;
    nutLui.disabled = true;
    nutTiep.textContent = "Đang gửi…";
    loiGui.hidden = true;
    try {
      await guiPhieu();
    } catch (e) {
      // Không in dữ liệu bệnh nhân ra console; chỉ báo lỗi cho người dùng.
      loiGui.textContent =
        e instanceof Error && e.message ? e.message : "Vui lòng kiểm tra mạng rồi thử lại.";
      loiGui.hidden = false;
      nutTiep.textContent = "Gửi phiếu";
    } finally {
      nutTiep.disabled = false;
      nutLui.disabled = false;
    }
  });

  nutLui.addEventListener("click", () => {
    // Có lịch sử do mình đẩy vào thì lùi bằng history.back() cho khớp nút
    // Back của máy; mở lại từ bản nháp (buoc = 0) thì lùi thẳng.
    if (buoc > 0) return history.back();
    const duong = duongDi();
    const i = duong.indexOf(hienTai);
    if (i > 0) {
      hienPhan(duong[i - 1]);
      // Mục lịch sử hiện tại phải đổi theo, kẻo Back sau này quay về phần cũ.
      if (!LA_ADMIN) history.replaceState({ phan: duong[i - 1], i: 0 }, "");
    }
  });

  if (!LA_ADMIN) window.addEventListener("popstate", (e) => {
    if (hienTai === "xong") return;
    hoanLuu(); // nháp nhớ phần đang xem sau khi lùi/tiến bằng nút Back
    buoc = e.state?.i ?? 0;
    const muc = e.state?.phan as string | undefined;
    const duong = duongDi();
    if (muc && duong.includes(muc)) return hienPhan(muc);
    // Mục lịch sử cũ không còn nằm trên đường đi (đã đổi chuyên khoa…):
    // lùi về phần liền trước phần đang xem.
    const i = duong.indexOf(hienTai);
    if (i > 0) hienPhan(duong[i - 1]);
  });

  function datLaiPhieu() {
    form.reset();
    form.querySelectorAll<HTMLElement>(".q-khac").forEach((o) => (o.hidden = true));
    dsAnh.length = 0;
    veDsAnh();
    form.querySelectorAll(".q-thieu").forEach((q) => q.classList.remove("q-thieu"));
    form.querySelectorAll<HTMLElement>(".q-loi").forEach((e) => (e.hidden = true));
    xoaNhap();
    buoc = 0;
    if (!LA_ADMIN) history.replaceState({ phan: "vande", i: 0 }, "");
    hienPhan("vande");
    // Gửi xong ở chế độ admin nút còn dòng "Đang gửi…": đưa về chữ đầu.
    nutTiep.disabled = false;
    nutLui.disabled = false;
    // Form đã trắng: trang cha phải xóa bảng điểm theo.
    baoThayDoi();
  }
  document.getElementById("lamLai")?.addEventListener("click", datLaiPhieu);
  // Trang admin gọi khi đóng hộp thoại (hoặc đã gửi xong) để lần mở sau là phiếu trắng.
  goc.addEventListener("phieu:dat-lai", datLaiPhieu);

  // ---- Lưu nháp 24 giờ ----------------------------------------------------
  // Bệnh nhân điền dở rồi chuyển trang, tải lại hay thoát ra thì quay lại
  // điền tiếp được. Lưu ngay trong trình duyệt của họ (localStorage), tự hết
  // hạn sau 24 giờ và xóa khi gửi xong hay bấm "Làm lại". Đây là dữ liệu sức
  // khỏe trên máy có thể dùng chung, nên KHÔNG lưu họ tên, năm sinh, số điện
  // thoại, và không lưu ảnh (bệnh nhân chọn lại ảnh).
  const KHOA_NHAP = "phieu-nhap-v1";
  const HAN_NHAP_MS = 24 * 60 * 60 * 1000;
  const KHONG_LUU = ["ho_ten", "nam_sinh", "sdt", "website"];
  let buoc = 0;

  // Chế độ admin tắt hẳn nháp: máy của bác sĩ, dữ liệu bệnh nhân người khác.
  function xoaNhap() {
    if (LA_ADMIN) return;
    try { localStorage.removeItem(KHOA_NHAP); } catch { /* trình duyệt chặn lưu trữ: bỏ qua */ }
  }

  function luuNhap() {
    if (LA_ADMIN || hienTai === "xong") return;
    try {
      const tra_loi: Record<string, string | string[]> = {};
      form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>("input[name], textarea[name]").forEach((o) => {
        if (KHONG_LUU.includes(o.name) || o.type === "file") return;
        if (o.type === "radio" || o.type === "checkbox") {
          if (!o.checked) return;
          const ds = (tra_loi[o.name] as string[] | undefined) ?? [];
          ds.push(o.value);
          tra_loi[o.name] = ds;
        } else if (o.value) {
          tra_loi[o.name] = o.value;
        }
      });
      localStorage.setItem(KHOA_NHAP, JSON.stringify({ luc: Date.now(), phan: hienTai, tra_loi }));
    } catch { /* đầy bộ nhớ hoặc bị chặn: phiếu vẫn điền bình thường, chỉ không có nháp */ }
  }

  function khoiPhucNhap(): string | null {
    if (LA_ADMIN) return null;
    try {
      const tho = localStorage.getItem(KHOA_NHAP);
      if (!tho) return null;
      const nhap = JSON.parse(tho);
      if (!nhap || Date.now() - nhap.luc > HAN_NHAP_MS) { xoaNhap(); return null; }
      for (const [ten, gt] of Object.entries(nhap.tra_loi as Record<string, string | string[]>)) {
        form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>(`[name="${ten}"]`).forEach((o) => {
          if (o.type === "radio" || o.type === "checkbox") o.checked = Array.isArray(gt) && gt.includes(o.value);
          else if (typeof gt === "string") o.value = gt;
        });
      }
      // Ô gõ chữ của đáp án "Khác" chỉ hiện khi "Khác" đang được chọn.
      form.querySelectorAll<HTMLElement>(".q").forEach((q) => {
        const o_khac = q.querySelector<HTMLElement>(".q-khac");
        const nut_khac = q.querySelector<HTMLInputElement>("input[data-khac]");
        if (o_khac && nut_khac) o_khac.hidden = !nut_khac.checked;
      });
      return typeof nhap.phan === "string" && duongDi().includes(nhap.phan) ? nhap.phan : "vande";
    } catch {
      xoaNhap();
      return null;
    }
  }

  let hen_luu: number | undefined;
  const hoanLuu = () => {
    clearTimeout(hen_luu);
    hen_luu = window.setTimeout(luuNhap, 400);
  };
  form.addEventListener("input", hoanLuu);
  form.addEventListener("change", hoanLuu);

  const phan_khoi_phuc = khoiPhucNhap();
  if (phan_khoi_phuc) {
    hienPhan(phan_khoi_phuc, false);
  } else {
    hienPhan("vande", false);
  }
  if (!LA_ADMIN) history.replaceState({ phan: hienTai, i: 0 }, "");
</script>
