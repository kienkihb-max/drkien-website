---
// Lưới thẻ sản phẩm — dùng chung cho trang danh sách /san-pham và khối
// "Các sản phẩm khác" ở cuối mỗi trang chi tiết.
//
// Vì sao là component: hai chỗ đó dựng cùng một loại thẻ. Chép markup sang
// chỗ thứ hai là sau này sửa thẻ phải nhớ sửa hai nơi, và kiểu gì cũng có
// ngày quên một nơi. Toàn bộ markup lẫn CSS của thẻ nằm gọn trong file này.
//
// THẺ CHỈ CÓ ẢNH, ICON VÀ TÊN. Không công dụng, không mô tả — chủ site đã
// chốt nhiều lần. Muốn biết thêm thì bấm vào thẻ, sang trang chi tiết.
//
// Chữ trên thẻ và ảnh đọc từ data/san-pham.mjs, không sửa ở đây.
import { CHU_BAN_CHAY, moTaAnh } from "../data/san-pham.mjs";
import {
  Leaf,
  Footprints,
  Droplets,
  BottleWine,
  FlaskConical,
  Flower2,
} from "@lucide/astro";

// Khai từng icon một chứ không nhập cả bộ Lucide — nhập cả bộ là kéo hơn
// 1800 icon vào lúc dựng. Thêm món mới với icon lạ thì thêm một dòng ở đây
// cho khớp trường "icon" trong san-pham.mjs, nếu không thẻ sẽ thiếu hình.
const ICON = { Leaf, Footprints, Droplets, BottleWine, FlaskConical, Flower2 };

interface Props {
  /** Các món cần hiện. Thứ tự hiện đúng thứ tự trong mảng truyền vào. */
  items: any[];
}
const { items } = Astro.props;
---

<div class="product-grid">
  {items.map((m) => {
    const Icon = ICON[m.icon];
    return (
      <a class="product-card" href={"/san-pham/" + m.slug}>
        {/* Món chưa có ảnh thì ô ảnh hiện icon trên nền nhạt, giữ đúng khổ
            để lưới không so le. Có ảnh rồi thì thêm dòng anh/anh_alt trong
            san-pham.mjs, không phải sửa ở đây. */}
        {m.anh ? (
          <img src={"/assets/img/" + m.anh} alt={moTaAnh(m.ten)} loading="lazy" />
        ) : (
          <span class="product-card-noimg">{Icon && <Icon size={56} stroke-width={1.3} />}</span>
        )}
        {m.ban_chay && <span class="badge-bestseller">{CHU_BAN_CHAY}</span>}
        <h3 class="product-card-title">
          {Icon && <Icon size={19} stroke-width={1.8} />}
          {m.ten}
        </h3>
      </a>
    );
  })}
</div>

<style>
  /* Lưới ba cột. Astro tự giới hạn phạm vi khối này cho riêng component,
     nên không đụng tới lưới nào khác của site. */
  .product-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }
  @media (max-width: 960px) {
    .product-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 16px;
    }
  }
  /* Điện thoại vẫn giữ 2 cột. Xuống 1 cột thì mỗi thẻ cao gần hết màn
     hình, cuộn mãi mới hết 6 món — nhìn như trang chỉ có một sản phẩm. */
  @media (max-width: 520px) {
    .product-grid {
      gap: 12px;
    }
  }

  /* Thẻ món: chỉ có ảnh và tên, nên không dùng .info-card (thẻ đó có nền
     trắng và padding dày, để trống một mảng lớn khi không có chữ bên trong). */
  .product-card {
    /* Cột dọc để phần tên giãn ra lấp nốt chiều cao thừa: tên dài xuống hai
       dòng làm thẻ đó cao hơn, lưới kéo mấy thẻ kia cao bằng, và nếu tên
       không giãn thì mấy thẻ kia hở một khoảng trắng dưới đáy. */
    display: flex;
    flex-direction: column;
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--shadow-card);
    background: #fff;
    /* Mốc cho nhãn "Bán chạy" đặt tuyệt đối lên góc ảnh. */
    position: relative;
    /* Cả thẻ là một liên kết sang trang chi tiết — bỏ gạch chân và giữ màu
       chữ như cũ, chỉ nhích lên khi rê chuột để biết là bấm được. */
    color: inherit;
    text-decoration: none;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .product-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 12px 28px rgba(0, 0, 0, 0.13);
  }

  .product-card img {
    display: block;
    width: 100%;
    /* Khổ VUÔNG. Ảnh đã cắt sẵn 1:1 từ ảnh gốc nên ở đây không xén thêm
       gì — object-fit: cover chỉ để phòng khi có ảnh lạc khổ. */
    aspect-ratio: 1 / 1;
    object-fit: cover;
    background: #f1f1f1;
  }

  /* Ô thay ảnh cho món chưa có ảnh chụp. Cùng khổ 3:4 với thẻ có ảnh để lưới
     không so le, nền nhạt và icon to ở giữa cho biết là còn thiếu ảnh chứ
     không phải ảnh hỏng. */
  .product-card-noimg {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    aspect-ratio: 1 / 1;
    background: #f2f5fb;
    color: var(--primary);
    opacity: 0.55;
  }

  /* Nhãn góc ảnh. Đặt đè lên ảnh chứ không chen thêm một dòng dưới tên: thẻ
     chỉ có ảnh và tên, thêm dòng nữa là mấy thẻ không có nhãn bị hụt so với
     thẻ có nhãn. */
  .badge-bestseller {
    position: absolute;
    top: 12px;
    left: 12px;
    z-index: 1;
    padding: 5px 12px;
    border-radius: 999px;
    background: var(--primary);
    color: #fff;
    font-family: "Be Vietnam Pro", system-ui, sans-serif;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.01em;
    /* Ảnh sản phẩm chỗ sáng chỗ tối, đổ bóng để chữ trắng không chìm mất
       khi nhãn rơi đúng vùng sáng. */
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.25);
  }

  .product-card-title {
    /* Giãn ra lấp chiều cao thừa, để tên vẫn nằm giữa phần trắng dưới ảnh
       kể cả khi thẻ bên cạnh có tên dài hơn một dòng. */
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    margin: 0;
    padding: 16px 14px;
    font-family: "Be Vietnam Pro", system-ui, sans-serif;
    /* Khai rõ cỡ chữ thay vì ăn theo cỡ h3 chung của site (20px): thẻ chỉ
       rộng hơn 160px trên điện thoại, 20px là tên dài vỡ thành ba dòng. */
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--primary);
    text-align: center;
  }

  /* Trên điện thoại tên căn trái: căn giữa thì tên dài vỡ hai dòng xong
     nhìn lệch hẳn so với thẻ tên ngắn bên cạnh. */
  @media (max-width: 720px) {
    .product-card-title {
      justify-content: flex-start;
      align-items: flex-start;
      text-align: left;
      gap: 6px;
      padding: 12px 10px;
      font-size: 0.9rem;
    }
    /* Icon không được co lại khi tên dài, và nhích xuống 2px cho khớp đường
       chân chữ của dòng đầu — căn giữa theo chiều dọc thì nó trôi xuống
       khoảng giữa hai dòng, trông như rơi ra khỏi chữ. */
    .product-card-title svg {
      flex-shrink: 0;
      margin-top: 2px;
    }
  }
</style>
