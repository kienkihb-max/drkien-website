---
// Nhớ vị trí đang đọc của từng trang, quay lại (nút Back, vuốt quay lại, nút
// X ở trang chat) là về đúng chỗ đó. Gắn một lần trong layouts/Trang.astro
// nên mọi trang đều có.
//
// Trình duyệt vốn tự nhớ vị trí cuộn, nhưng hay trượt trên site này: ảnh tải
// chậm làm trang dài ra sau khi trình duyệt đã cuộn, và vài trình duyệt dựng
// sẵn trong ứng dụng (Zalo, Messenger…) không nhớ gì cả. Nên tự lưu vị trí
// theo từng địa chỉ trang, và khi quay lại thì cuộn tới đó — cuộn thêm một
// lần nữa khi ảnh đã tải xong, phòng trang dài ra.
//
// Chỉ khôi phục khi QUAY LẠI trang (Back/Forward). Bấm link mở trang mới thì
// vẫn bắt đầu từ đầu trang như bình thường.
---

<script>
  const STORE_KEY = "scroll-positions";
  // Chỉ nhớ chừng này trang gần nhất, khỏi phình bộ nhớ phiên.
  const MAX_PAGES = 30;
  const pageKey = location.pathname + location.search;

  const readAll = (): Record<string, number> => {
    try {
      return JSON.parse(sessionStorage.getItem(STORE_KEY) || "{}");
    } catch {
      return {};
    }
  };

  const save = () => {
    try {
      const all = readAll();
      delete all[pageKey];
      all[pageKey] = Math.round(window.scrollY);
      const keys = Object.keys(all);
      for (const k of keys.slice(0, Math.max(0, keys.length - MAX_PAGES))) delete all[k];
      sessionStorage.setItem(STORE_KEY, JSON.stringify(all));
    } catch {}
  };

  // Lưu khi người đọc ngừng cuộn một chút, và lúc rời trang.
  let timer = 0;
  window.addEventListener(
    "scroll",
    () => {
      window.clearTimeout(timer);
      timer = window.setTimeout(save, 200);
    },
    { passive: true },
  );
  window.addEventListener("pagehide", save);

  // Có phải vừa quay lại trang này bằng Back/Forward không.
  const nav = performance.getEntriesByType("navigation")[0] as PerformanceNavigationTiming | undefined;
  const isBackForward = nav?.type === "back_forward";

  if (isBackForward) {
    const y = readAll()[pageKey];
    if (typeof y === "number" && y > 0) {
      // Tự cuộn thay trình duyệt, kẻo hai bên giành nhau.
      if ("scrollRestoration" in history) history.scrollRestoration = "manual";
      const restore = () => window.scrollTo(0, y);
      requestAnimationFrame(restore);
      // Ảnh tải xong trang có thể dài ra — cuộn lại lần nữa, trừ khi người
      // đọc đã tự cuộn/chạm vào trang (họ đã bắt đầu đọc, đừng giật đi).
      let userMoved = false;
      const markMoved = () => (userMoved = true);
      for (const ev of ["wheel", "touchstart", "keydown"]) {
        window.addEventListener(ev, markMoved, { once: true, passive: true });
      }
      window.addEventListener(
        "load",
        () => {
          if (!userMoved && Math.abs(window.scrollY - y) > 4) restore();
        },
        { once: true },
      );
    }
  }
</script>
