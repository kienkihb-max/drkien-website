---
// Thẻ một bài viết — dùng cho cả trang blog lẫn khối "Bài viết khác" ở cuối
// mỗi bài.
//
// Phần dựng HTML nằm ở src/lib/the-bai.ts, không nằm ở đây: trang soạn bài
// cũng phải vẽ đúng tấm thẻ này để xem trước, mà nó chạy trong trình duyệt
// nên không gọi được component Astro. Hai bản chép tay là ô xem trước sẽ
// nói dối lúc nào không hay.
import type { BaiViet } from "../lib/supabase";
import { htmlTheBai } from "../lib/the-bai";

interface Props {
  bai: BaiViet;
  /** "event-card-featured" cho khối nổi bật, "related-card" cho cuối bài. */
  them_lop?: string;
}
const { bai, them_lop = "" } = Astro.props;

// Chữ trên thẻ là chữ người đọc thấy, có thể khác tiêu đề bài. Chưa đặt
// riêng thì lấy tiêu đề bài và mô tả Google.
const html = htmlTheBai(
  {
    slug: bai.slug,
    tieu_de: bai.the_tieu_de || bai.tieu_de,
    mo_ta: bai.the_mo_ta || bai.seo_mo_ta || "",
    anh: bai.anh,
    anh_alt: bai.anh_alt,
  },
  them_lop
);
---

<Fragment set:html={html} />
