---
// Khung chung của MỌI trang. Đây là chỗ duy nhất sinh ra thẻ <head>, nên
// toàn bộ SEO của site nằm ở file này — thiếu một thẻ ở đây là thiếu trên
// tất cả các trang, và ngược lại, sửa đúng ở đây là sửa xong cả site.
//
// Trước đây mỗi file .html tự chép tay ~20 dòng thẻ meta. 22 trang là 22 bản
// chép, và thực tế đã có trang lệch canonical với trang khác mà không ai
// biết. Nay chỉ còn một bản.
import { TEN_SITE, GOC } from "../data/thong-tin.mjs";
import { coAnh, laAnhNgoai } from "../lib/co-anh.mjs";
import BoIcon from "../components/BoIcon.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ChatWidget from "../components/ChatWidget.astro";

interface Props {
  /** Tiêu đề hiện trên tab và trên Google. Đã kèm sẵn " — Bác sĩ Lê Trung Kiên". */
  tieu_de: string;
  /**
   * Tiêu đề do người biên tập tự đặt trong CMS (ô "tiêu đề gửi Google").
   * Khi bật, dùng NGUYÊN VĂN, không nối thêm tên bác sĩ vào cuối — người đặt
   * đã tự canh tên và độ dài cho vừa dòng tiêu đề của Google.
   */
  tieu_de_tu_dat?: boolean;
  /** Mô tả hiện dưới tiêu đề trên Google. Nên 120–160 ký tự. */
  mo_ta: string;
  /** Đường dẫn không có đuôi .html, ví dụ "blog" hay "" cho trang chủ. */
  duong_dan: string;
  /** Ảnh hiện khi chia sẻ lên Facebook/Zalo. Đường dẫn tương đối trong site. */
  anh?: string;
  anh_alt?: string;
  /**
   * Kích thước ảnh chia sẻ, chỉ cần truyền khi ảnh nằm ngoài site (Supabase
   * Storage) — ảnh trong repo thì lúc build tự đo từ file.
   */
  anh_co?: { rong: number; cao: number } | null;
  /** "website" trang thường, "article" bài blog, "profile" trang hồ sơ. */
  loai?: "website" | "article" | "profile";
  /** Chỉ dùng cho bài viết. */
  ngay_dang?: string;
  /** Dữ liệu có cấu trúc (JSON-LD) riêng của trang, nếu có. */
  schema?: unknown;
  /**
   * Trang không được Google lập chỉ mục, ví dụ trang báo lỗi 404. Bỏ luôn
   * canonical: trang 404 mà trỏ canonical về chính nó là đang bảo Google
   * "đây là một trang thật, cứ lưu vào".
   */
  khong_lap_chi_muc?: boolean;
  /** Đặt vào thuộc tính data-page của <html>, style.css dựa vào đó. */
  loai_trang?: string;
  /** Thêm class cho <body>, ví dụ "subpage". */
  lop_body?: string;
  /**
   * Các file JS trong public/ mà riêng trang này cần, ví dụ ["lightbox.js"].
   * Header, footer và bộ icon đã dựng sẵn phía máy chủ nên KHÔNG khai ở đây.
   */
  scripts?: string[];
}

const {
  tieu_de,
  tieu_de_tu_dat = false,
  mo_ta,
  duong_dan,
  // Ảnh chia sẻ dùng chung của site. Trang chủ, trang hồ sơ và trang blog
  // đều dùng đúng file này — đừng đổi sang tên khác nếu file đó không có
  // thật, vì thẻ og:image trỏ vào ảnh không tồn tại thì link chia sẻ lên
  // Facebook hiện trơ không ảnh, mà trên trang thì chẳng có dấu hiệu gì.
  anh = "assets/img/og-share.jpg",
  anh_alt = "",
  anh_co = null,
  loai = "website",
  ngay_dang,
  schema,
  khong_lap_chi_muc = false,
  loai_trang,
  lop_body,
  scripts = [],
} = Astro.props;

const dia_chi = GOC + (duong_dan ? "/" + duong_dan : "/");
const anh_day_du = laAnhNgoai(anh) ? anh : GOC + "/" + anh.replace(/^\//, "");
// Đo kích thước thật của ảnh chia sẻ. Ghi cứng một cỡ cho mọi trang là sai
// ở gần như mọi trang — ảnh của site đang từ 565x353 tới 1600x1191.
//
// Ảnh trong repo thì đo thẳng từ file. Ảnh trên Supabase Storage thì không
// có file trên đĩa để đo, nên dùng số đã ghi lại lúc tải lên (trang truyền
// vào qua anh_co).
const co = laAnhNgoai(anh) ? anh_co ?? { rong: 1200, cao: 630 } : coAnh(anh);
// Tự thêm " — Bác sĩ Lê Trung Kiên" vào cuối tiêu đề, nhưng CHỈ cho trang
// dùng tiêu đề mặc định. Hai trường hợp phải để nguyên văn:
//
//  - Tiêu đề do người biên tập tự đặt (tieu_de_tu_dat) — họ đã canh sẵn tên
//    và độ dài.
//  - Tiêu đề đã tự chứa tên bác sĩ. Xét cả tên đầy đủ lẫn dạng ngắn "Bác sĩ
//    Kiên" mà CMS gắn làm tiền tố, và không phân biệt hoa thường: trước đây
//    chỉ dò tên đầy đủ nên mọi bài "Bác sĩ Kiên - …" đều bị nối thêm một lần
//    nữa, tiêu đề vọt quá 80 ký tự rồi Google cắt cụt.
const co_ten = /(bác sĩ|bs\.?)\s+(lê\s+trung\s+)?kiên/i.test(tieu_de);
const tieu_de_day_du =
  tieu_de_tu_dat || co_ten ? tieu_de : tieu_de + " — " + TEN_SITE;
---

<!DOCTYPE html>
<html lang="vi" data-page={loai_trang} data-ngay-dang={ngay_dang}>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>{tieu_de_day_du}</title>
  <meta name="description" content={mo_ta}>
  {khong_lap_chi_muc
    ? <meta name="robots" content="noindex, follow" />
    : <link rel="canonical" href={dia_chi} />}

  <!-- Tải font không chặn hiển thị: trình duyệt vẽ chữ bằng font hệ thống
       trước, đổi sang font riêng khi tải xong. Chữ hiện sớm hơn trên mạng chậm. -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@600;700&family=Inter:wght@400;500;600;700&display=swap">
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@600;700&family=Inter:wght@400;500;600;700&display=swap" media="print" onload="this.media='all'">
  <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@600;700&family=Inter:wght@400;500;600;700&display=swap"></noscript>

  <link rel="icon" href="/favicon.ico" sizes="any">
  <link rel="apple-touch-icon" href="/assets/img/apple-touch-icon.png">

  <meta property="og:type" content={loai}>
  <meta property="og:site_name" content={TEN_SITE}>
  <meta property="og:locale" content="vi_VN">
  <meta property="og:title" content={tieu_de_day_du}>
  <meta property="og:description" content={mo_ta}>
  <meta property="og:url" content={dia_chi}>
  <meta property="og:image" content={anh_day_du}>
  <meta property="og:image:width" content={String(co.rong)}>
  <meta property="og:image:height" content={String(co.cao)}>
  {anh_alt && <meta property="og:image:alt" content={anh_alt}>}
  {loai === "article" && ngay_dang && (
    <>
      <meta property="article:published_time" content={ngay_dang + "T08:00:00+07:00"}>
      <meta property="article:author" content="Bác sĩ Lê Trung Kiên">
    </>
  )}
  <meta name="twitter:card" content="summary_large_image">

  <link rel="stylesheet" href="/style.css">
  <!-- Dáng chữ thân bài, dùng chung với khung soạn thảo trong trang quản trị. -->
  <link rel="stylesheet" href="/bai-viet.css">

  {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)}></script>}
</head>
<body class={lop_body}>

<BoIcon />
<Header trang={duong_dan} />

<main>
  <slot />
</main>

<Footer />

<ChatWidget />

{/* Mấy phần còn chạy phía trình duyệt, chưa chuyển thành component Astro.
    thong-tin.js điền các chỗ đánh dấu data-tt, seo-schema.js sinh dữ liệu
    có cấu trúc cho trang tĩnh. Nạp is:inline để giữ nguyên là script cổ
    điển — chúng dùng biến toàn cục window, đóng gói thành module là hỏng. */}
{scripts.map((ten) => <script is:inline src={"/" + ten}></script>)}

</body>
</html>
