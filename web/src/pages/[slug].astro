---
// Trang một bài viết. Mỗi bài trong database thành một file .html riêng
// lúc build — đúng như site cũ, chỉ khác là không còn chép tay.
//
// getStaticPaths lấy CẢ bài đã gỡ khỏi danh sách (an = true). Bài gỡ không
// hiện ở danh sách nào, nhưng file vẫn phải tồn tại: link đã chia sẻ ra
// ngoài hoặc đã lên Google mà thành 404 là mất người đọc và mất điểm.
import Trang from "../layouts/Trang.astro";
import DuongDan from "../components/DuongDan.astro";
import DongTacGia from "../components/DongTacGia.astro";
import BaiKhac from "../components/BaiKhac.astro";
import BaiCungMuc from "../components/BaiCungMuc.astro";
import DichVuBenCanh from "../components/DichVuBenCanh.astro";
import CtaNoiBai from "../components/CtaNoiBai.astro";
import { layBaiCanSinhFile, layBaiHienLen, type BaiViet } from "../lib/supabase";
import { GOC, TEN_SITE } from "../data/thong-tin.mjs";
import { duongDanAnh, laAnhNgoai } from "../lib/co-anh.mjs";
import { tenChuyenMuc, diaChiChuyenMuc } from "../lib/chuyen-muc";

export async function getStaticPaths() {
  const tat_ca = await layBaiCanSinhFile();
  const hien_len = await layBaiHienLen();
  return tat_ca.map((bai) => ({
    params: { slug: bai.slug },
    props: { bai, hien_len },
  }));
}

interface Props {
  bai: BaiViet;
  hien_len: BaiViet[];
}
const { bai, hien_len } = Astro.props;

const dia_chi = GOC + "/" + bai.slug;
// Ảnh trên Supabase Storage đã là địa chỉ đầy đủ rồi; chỉ ảnh trong repo
// mới cần ghép thêm tên miền vào trước.
const anh_day_du = bai.anh
  ? laAnhNgoai(bai.anh)
    ? bai.anh
    : GOC + "/" + bai.anh.replace(/^\//, "")
  : undefined;
const mo_ta = bai.seo_mo_ta ?? bai.the_mo_ta ?? "";
/** Ảnh bìa chụp dọc. Bài cũ chưa ghi kích thước thì coi như ảnh ngang. */
const anh_bia_doc = !!(bai.anh_rong && bai.anh_cao && bai.anh_cao > bai.anh_rong);

// Chuyên mục cho breadcrumb: "Blog" là nấc trỏ về trang danh sách, còn
// tên mục nay bấm được — dẫn sang trang gom mọi bài cùng mục.
const ten_muc = tenChuyenMuc(bai.nhan);
const chuyen_muc = ten_muc
  ? [{ chu: ten_muc, dia_chi: diaChiChuyenMuc(ten_muc) }]
  : [];

// Dữ liệu có cấu trúc cho Google. Dựng sẵn phía máy chủ thay vì để JS sinh
// lúc chạy, vì đây đúng là thứ quyết định bài có được hiện dạng kết quả
// giàu thông tin hay không.
const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "MedicalScholarlyArticle",
      "@id": dia_chi + "#baiviet",
      headline: bai.tieu_de.slice(0, 110),
      name: bai.tieu_de,
      description: mo_ta,
      inLanguage: "vi-VN",
      datePublished: bai.ngay_dang,
      // Bài từng biên tập lại thì dateModified phải là ngày biên tập, không
      // phải ngày đăng — Google dùng nó để biết nội dung còn mới hay không.
      dateModified: bai.ngay_sua || bai.ngay_dang,
      ...(anh_day_du ? { image: anh_day_du } : {}),
      author: { "@type": "Person", name: "Bác sĩ Lê Trung Kiên", url: GOC + "/bac-si-le-trung-kien" },
      publisher: { "@type": "Person", name: TEN_SITE, url: GOC + "/" },
      mainEntityOfPage: dia_chi,
    },
    {
      "@type": "BreadcrumbList",
      "@id": dia_chi + "#breadcrumb",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Trang chủ", item: GOC + "/" },
        { "@type": "ListItem", position: 2, name: "Blog", item: GOC + "/blog" },
        ...(ten_muc
          ? [{ "@type": "ListItem", position: 3, name: ten_muc, item: GOC + diaChiChuyenMuc(ten_muc) }]
          : []),
        { "@type": "ListItem", position: ten_muc ? 4 : 3, name: bai.tieu_de, item: dia_chi },
      ],
    },
  ],
};
---

<Trang
  tieu_de={bai.seo_tieu_de ?? bai.tieu_de}
  mo_ta={mo_ta}
  duong_dan={bai.slug}
  anh={bai.anh ?? undefined}
  anh_alt={bai.anh_alt ?? ""}
  anh_co={bai.anh_rong && bai.anh_cao ? { rong: bai.anh_rong, cao: bai.anh_cao } : null}
  loai="article"
  ngay_dang={bai.ngay_dang}
  loai_trang="article"
  lop_body="subpage"
  schema={schema}
>
  <section class="section cv-hero">
    <div class="container">
      {/* Không đưa tên bài vào breadcrumb: nó đã nằm ngay dưới ở thẻ <h1>
          cỡ lớn. Nhắc lại lần nữa chỉ tốn một dòng, mà bài tên dài thì
          breadcrumb xuống hai dòng và đẩy tiêu đề tụt xuống. */}
      <DuongDan giua={[{ chu: "Blog", dia_chi: "/blog" }, ...chuyen_muc]} />
      <h1>{bai.tieu_de}</h1>
      <DongTacGia ngay={bai.ngay_dang} />
    </div>
  </section>

  <section class="section section-article">
    <div class="container">
      <div class="article-layout">
        <div class="article-chinh">
      {/* Ảnh bìa cao hơn rộng thì giữ nguyên tỉ lệ gốc thay vì cắt về khung
          16/9 — cắt thì ảnh chụp người còn mỗi một dải ngang giữa ảnh. */}
      {bai.anh && (
        <div class:list={["article-hero-img", anh_bia_doc && "article-hero-img-doc"]}>
          <img src={duongDanAnh(bai.anh)} alt={bai.anh_alt ?? ""} loading="lazy"
               width={bai.anh_rong ?? undefined} height={bai.anh_cao ?? undefined}>
        </div>
      )}
      <div class="article-body">
        {/* Ghép đoạn mở đầu vào cùng một chuỗi với thân bài, có xuống dòng
            ngăn giữa. Để hai thẻ rời nhau thì Astro dán sát "</p><p>" và
            mất đúng một dấu cách so với bài gốc — không đổi giao diện,
            nhưng bộ đối chiếu sẽ báo lệch mãi, mà lệch thì phải sửa chứ
            không phải để đó rồi quen mắt. */}
        <Fragment set:html={(bai.lead ? `<p class="lead">${bai.lead}</p>\n` : "") + bai.than_bai} />
      </div>

        {bai.tai_lieu?.length > 0 && (
          <div class="article-refs">
            <h2>Tài liệu tham khảo</h2>
            <ol>
              {bai.tai_lieu.map((m) => <li set:html={m} />)}
            </ol>
          </div>
        )}
        </div>

        <aside class="article-aside">
          <DichVuBenCanh bai={bai} />
          <BaiCungMuc danh_sach={hien_len} bai={bai} />
        </aside>
      </div>
    </div>
  </section>

  <BaiKhac danh_sach={hien_len} tru_slug={bai.slug} tren_la_alt={false} />

  <CtaNoiBai bai={bai} />
</Trang>
