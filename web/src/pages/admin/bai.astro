---
// Soạn bài mới hoặc sửa bài có sẵn.
//   /admin/bai         → bài mới
//   /admin/bai?id=...  → sửa bài đó
//
// Đây mới là VỎ: đủ để bài nằm được trong database và đăng lên. Trình soạn
// thảo dùng lại admin-soan-thao.js của trang cũ nguyên xi — phần nâng cấp
// soạn thảo làm ở bước sau.
import VetLoi from "../../components/VetLoi.astro";
---

<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="robots" content="noindex, nofollow">
  <title>Soạn bài — Quản trị blog</title>
  <link rel="icon" href="/favicon.ico" sizes="any">
  <link rel="stylesheet" href="/admin.css">
</head>
<body>

<VetLoi />

<div id="man-chinh" hidden>
  <header class="qt-dau">
    <div class="qt-dau-trai">
      <strong><a href="/admin">Quản trị blog</a></strong>
      <span class="qt-kho" id="nhan-tai-khoan"></span>
    </div>
    <div class="qt-dau-phai">
      <button class="qt-nut qt-nut-nhe" type="button" id="nut-quay-lai">Quay lại</button>
      <!-- Hai chế độ xem, chỉ hiện khi bài đã đăng MÀ đang có bản sửa treo:
           lúc đó mới có hai bản khác nhau để so. -->
      <div class="qt-che-do" id="chon-che-do" hidden>
        <button class="qt-che-do-nut" type="button" id="nut-xem-dang">Bản đã đăng</button>
        <button class="qt-che-do-nut" type="button" id="nut-xem-nhap">Bản đang sửa</button>
      </div>
      <button class="qt-nut qt-nut-nhe" type="button" id="nut-bo-nhap" hidden>Bỏ bản sửa</button>
      <!-- Mỗi lúc chỉ MỘT trong hai nút dưới hiện: còn thay đổi chưa lưu thì
           là "Lưu", lưu xong mới tới "Đăng". Hai nút cạnh nhau là chỗ dễ bấm
           nhầm nhất, mà bấm nhầm ở đây thì bài rơi khỏi blog. -->
      <button class="qt-nut qt-nut-chinh" type="button" id="nut-luu" hidden>Lưu</button>
      <button class="qt-nut qt-nut-chinh" type="button" id="nut-dang" hidden>Đăng</button>
    </div>
  </header>

  <main class="qt-than">
    <div class="qt-hang-tieu-de">
      <div>
        <h2 id="tieu-de-man">Viết bài mới</h2>
        <p class="qt-phu" id="duong-dan-xem"></p>
      </div>
    </div>

    <p class="qt-bao" id="bao" hidden></p>

    <form id="form-bai" autocomplete="off">
      <fieldset class="qt-nhom">
        <legend>Nội dung bài viết</legend>

        <label class="qt-nhan" for="o-tieu-de">Tiêu đề bài viết</label>
        <input class="qt-o" type="text" id="o-tieu-de" required>

        <label class="qt-nhan" for="o-slug">Đường dẫn</label>
        <p class="qt-goi-y">
          Chốt một lần lúc tạo bài. Bài đã đăng mà đổi đường dẫn thì mọi link
          đã chia sẻ ra ngoài sẽ thành trang lỗi và bài mất thứ hạng Google.
        </p>
        <input class="qt-o" type="text" id="o-slug" required>

        <label class="qt-nhan" for="o-nhan">Chuyên mục</label>
        <input class="qt-o" type="text" id="o-nhan" placeholder="Blog · Y học cổ truyền">

        <label class="qt-nhan" for="o-lead">Đoạn mở đầu</label>
        <textarea class="qt-o qt-o-cao" id="o-lead" rows="3"></textarea>

        <label class="qt-nhan">Thân bài</label>
        <div id="khung-soan"></div>
        <p class="qt-phu" id="dem-chu"></p>

        <label class="qt-nhan" for="o-tai-lieu">Tài liệu tham khảo</label>
        <p class="qt-goi-y">
          Mỗi tài liệu một dòng, không cần đánh số — trang bài tự đánh. Bỏ
          trống thì khối này không hiện. Với bài y khoa, đây là phần Google
          dùng để chấm độ tin cậy chuyên môn.
        </p>
        <textarea class="qt-o qt-o-cao" id="o-tai-lieu" rows="5"></textarea>
      </fieldset>

      <fieldset class="qt-nhom">
        <legend>Ảnh bìa</legend>
        <p class="qt-goi-y">
          Ảnh này hiện ở đầu bài, trên thẻ ngoài trang blog, và là ảnh người
          ta thấy khi bài được chia sẻ lên Facebook hay Zalo. Ảnh to sẽ tự
          thu nhỏ còn 1600px và nén lại trước khi tải lên.
        </p>

        <div class="qt-tha-anh" id="tha-anh">
          <img id="xem-anh" alt="" hidden>
          <div id="tha-anh-chu">
            <p>Kéo ảnh thả vào đây, hoặc</p>
            <button class="qt-nut" type="button" id="nut-chon-anh">Chọn ảnh từ máy</button>
          </div>
          <input type="file" id="o-tep-anh" accept="image/*" hidden>
        </div>
        <p class="qt-phu" id="tin-anh"></p>

        <label class="qt-nhan" for="o-anh-alt">Mô tả ảnh</label>
        <p class="qt-goi-y">
          Tả đúng những gì có trong ảnh, cho người khiếm thị và cho Google.
          Ảnh có mặt bác sĩ thì viết đủ "Bác sĩ Lê Trung Kiên", đừng viết tắt.
        </p>
        <input class="qt-o" type="text" id="o-anh-alt">

        <!-- Đường dẫn thật, để xem lại hoặc dán tay khi cần. -->
        <label class="qt-nhan" for="o-anh">Đường dẫn ảnh</label>
        <input class="qt-o" type="text" id="o-anh" placeholder="assets/img/ten-anh.jpg">
        <input type="hidden" id="o-anh-rong">
        <input type="hidden" id="o-anh-cao">
      </fieldset>

      <fieldset class="qt-nhom">
        <legend>Hiển thị</legend>
        <label class="qt-nhan" for="o-ngay">Ngày đăng</label>
        <input class="qt-o qt-o-hep" type="date" id="o-ngay">
        <label><input type="checkbox" id="o-noi-bat"> Đưa lên khối nổi bật đầu trang blog</label>
        <label><input type="checkbox" id="o-an"> Gỡ khỏi danh sách (địa chỉ cũ vẫn sống)</label>
      </fieldset>

      <fieldset class="qt-nhom">
        <legend>Chữ hiện trên thẻ blog</legend>
        <p class="qt-goi-y">
          Đây là chữ người đọc thấy trên trang blog. Máy điền sẵn theo tiêu đề
          và đoạn mở đầu; anh sửa được, và sửa rồi thì máy thôi không điền đè.
        </p>

        <label class="qt-nhan" for="o-the-tieu-de">Tiêu đề trên thẻ</label>
        <input class="qt-o" type="text" id="o-the-tieu-de" data-dem="70">

        <label class="qt-nhan" for="o-the-mo-ta">Mô tả trên thẻ</label>
        <textarea class="qt-o qt-o-cao" id="o-the-mo-ta" rows="3" data-dem="160"></textarea>
      </fieldset>

      <fieldset class="qt-nhom">
        <legend>Chữ hiện trên Google</legend>
        <p class="qt-goi-y">
          Hai ô này máy tự sinh và khoá lại — chủ site không phải nghĩ về SEO.
          Muốn đổi thì sửa tiêu đề hoặc đoạn mở đầu, chúng sẽ đổi theo.
        </p>

        <label class="qt-nhan" for="o-seo-tieu-de">
          Tiêu đề trên Google <span class="qt-tu-dong">tự sinh</span>
        </label>
        <input class="qt-o" type="text" id="o-seo-tieu-de" data-dem="60" disabled>

        <label class="qt-nhan" for="o-seo-mo-ta">
          Mô tả trên Google <span class="qt-tu-dong">tự sinh</span>
        </label>
        <textarea class="qt-o qt-o-cao" id="o-seo-mo-ta" rows="3" data-dem="160" disabled></textarea>
      </fieldset>
    </form>
  </main>
</div>

<div class="qt-lop qt-lop-cho" id="man-cho">
  <p class="qt-phu">Đang tải…</p>
</div>

<!-- Trình soạn thảo của trang cũ, dùng lại nguyên xi. BaiViet phải nạp
     trước vì SoanThao gọi BaiViet.thoat() lúc dán chữ. -->
<script is:inline src="/admin-bai-viet.js"></script>
<script is:inline src="/admin-soan-thao.js"></script>

<script>
  import { supabase } from "../../lib/supabase";
  import { taiAnhLen } from "../../lib/tai-anh";
  import { duongDanAnh } from "../../lib/dia-chi-anh.mjs";

  const o = (id: string) => document.getElementById(id) as HTMLInputElement;
  const el = (id: string) => document.getElementById(id) as HTMLElement;

  let id_bai = new URLSearchParams(location.search).get("id");
  let bo_soan: any = null;

  // ——— Bản đã đăng và bản đang sửa ———
  // Bài đã đăng thì hai bản sống song song: bản trên web nằm trong bai_viet,
  // bản đang sửa nằm trong ban_nhap. Người viết xem được cả hai, và bản trên
  // web chỉ đổi khi bấm Đăng.
  /** Bài này đang hiện trên web hay chưa. */
  let bai_da_dang = false;
  /** Bài đã đăng này có bản sửa treo trong ban_nhap hay không. */
  let co_ban_nhap = false;
  /** "nhap" là bản đang sửa (gõ được), "dang" là bản đã đăng (chỉ xem). */
  let che_do: "nhap" | "dang" = "nhap";
  /** Ảnh chụp bản đã đăng, để chế độ "Bản đã đăng" khỏi phải hỏi lại server. */
  let ban_tren_web: Record<string, any> | null = null;
  /** Bản sửa đang treo, để đổi chế độ qua lại không mất phần đã lưu. */
  let ban_nhap_hien: Record<string, any> | null = null;
  /**
   * Ảnh chụp form ở lần lưu gần nhất, dạng chuỗi JSON. So với hiện tại để
   * biết còn thay đổi chưa lưu hay không — đó là thứ quyết định hiện nút
   * "Lưu" hay nút "Đăng".
   */
  let moc_sach = "";

  // Mốc theo dõi, chỉ có tác dụng khi chạy dev (xem components/VetLoi.astro).
  const vet = (chu: string, ct?: unknown) =>
    (window as any).vet?.(chu, ct === undefined ? "" : JSON.stringify(ct));

  function bao(chu: string, loi = false) {
    const b = el("bao");
    b.textContent = chu;
    b.className = "qt-bao " + (loi ? "qt-bao-loi" : "qt-bao-tot");
    b.hidden = false;
  }

  // Đổi tiêu đề thành đường dẫn: bỏ dấu tiếng Việt, thay khoảng trắng bằng
  // gạch nối. Chỉ chạy khi tạo bài mới.
  function tenFile(chu: string) {
    return chu
      .normalize("NFD").replace(/[̀-ͯ]/g, "")
      .replace(/đ/g, "d").replace(/Đ/g, "D")
      .toLowerCase()
      .replace(/[^a-z0-9]+/g, "-")
      .replace(/^-+|-+$/g, "");
  }

  // ——— Ảnh bìa ———
  function veXemAnh() {
    const dia_chi = o("o-anh").value.trim();
    const xem = o("xem-anh") as unknown as HTMLImageElement;
    const chu = el("tha-anh-chu");
    if (dia_chi) {
      xem.src = duongDanAnh(dia_chi);
      xem.hidden = false;
      chu.hidden = true;
    } else {
      xem.hidden = true;
      chu.hidden = false;
    }
  }

  async function nhanAnh(tep: File | undefined) {
    if (!tep) return;
    const tin = el("tin-anh");
    tin.className = "qt-phu";
    tin.textContent = "Đang thu nhỏ và tải ảnh lên…";
    try {
      // Xếp ảnh theo slug bài để kho ảnh không thành một đống phẳng.
      const kq = await taiAnhLen(tep, o("o-slug").value.trim() || "chung");
      o("o-anh").value = kq.dia_chi;
      o("o-anh-rong").value = String(kq.rong);
      o("o-anh-cao").value = String(kq.cao);
      veXemAnh();
      tin.textContent =
        `Xong — ${kq.rong}×${kq.cao}px, ${Math.round(kq.co_file / 1024)} KB.` +
        (o("o-anh-alt").value.trim() ? "" : " Nhớ điền mô tả ảnh bên dưới.");
    } catch (e) {
      tin.className = "qt-loi";
      tin.textContent = (e as Error).message;
    }
  }

  el("nut-chon-anh").addEventListener("click", () => o("o-tep-anh").click());
  o("o-tep-anh").addEventListener("change", (e) => {
    nhanAnh((e.target as HTMLInputElement).files?.[0]);
  });
  o("o-anh").addEventListener("input", veXemAnh);

  // Kéo thả. Phải chặn cả dragover, không thì trình duyệt mở thẳng tấm ảnh
  // ra thay vì đưa cho mình, và người viết mất luôn bài đang soạn dở.
  const khung_tha = el("tha-anh");
  ["dragenter", "dragover"].forEach((ten) =>
    khung_tha.addEventListener(ten, (e) => {
      e.preventDefault();
      khung_tha.classList.add("qt-tha-anh-dang");
    })
  );
  ["dragleave", "drop"].forEach((ten) =>
    khung_tha.addEventListener(ten, () => khung_tha.classList.remove("qt-tha-anh-dang"))
  );
  khung_tha.addEventListener("drop", (e) => {
    e.preventDefault();
    nhanAnh((e as DragEvent).dataTransfer?.files?.[0]);
  });

  // ——— Tự điền SEO ———
  // Chủ site không phải dân SEO, nên toàn bộ phần này máy lo: đường dẫn,
  // tiêu đề Google, mô tả Google. Hai ô hiển thị trên thẻ blog vẫn sửa được
  // vì đó là chữ người đọc thấy; gõ tay rồi thì máy thôi không điền đè.

  const DUOI_TIEU_DE = " — Bác sĩ Lê Trung Kiên";

  // Ô nào người viết đã tự gõ thì đánh dấu, để không bị máy ghi đè.
  const tay: Record<string, boolean> = {};
  ["o-the-tieu-de", "o-the-mo-ta"].forEach((id) => {
    o(id).addEventListener("input", () => { tay[id] = true; });
  });

  // Cắt một đoạn dài thành mô tả: ưu tiên dừng ở trọn câu, quá dài thì cắt
  // ở ranh giới từ rồi thêm dấu ba chấm. Cắt giữa từ trông rất cẩu thả trên
  // trang kết quả Google.
  function catMoTa(chu: string, muc: number) {
    chu = (chu || "").replace(/\s+/g, " ").trim();
    if (chu.length <= muc) return chu;
    const cat = chu.slice(0, muc);
    const het_cau = Math.max(cat.lastIndexOf(". "), cat.lastIndexOf("! "), cat.lastIndexOf("? "));
    if (het_cau > muc * 0.55) return cat.slice(0, het_cau + 1);
    return cat.slice(0, cat.lastIndexOf(" ")) + "…";
  }

  // Nguồn để sinh mô tả: ưu tiên đoạn mở đầu, không có thì lấy đoạn văn đầu
  // tiên của thân bài.
  //
  // Trang admin cũ chỉ đọc ô "đoạn mở đầu", nên bài nào bỏ trống ô đó là mô
  // tả Google trống theo — đúng chuyện vừa xảy ra với bài test: dán nguyên
  // bài vào thân bài, không điền lead, thế là Google phải tự bịa đoạn mô tả.
  function nguonMoTa() {
    const lead = o("o-lead").value.trim();
    if (lead) return lead;

    const vung = el("khung-soan")?.querySelector(".st-vung");
    if (!vung) return "";

    // Gom các đoạn văn cho tới khi đủ dài, thay vì chỉ lấy đoạn đầu.
    //
    // Lấy mỗi đoạn đầu là hỏng đúng kiểu bài hay gặp: dòng mở bài thường là
    // một câu tựa ngắn cụt ("Khi chạy bộ không chỉ là chuyện của đôi chân"),
    // ra mô tả 44 ký tự trong khi Google hiển thị được tới 160 — vừa phí
    // chỗ vừa không nói được bài viết về cái gì.
    const doan: string[] = [];
    vung.querySelectorAll("p").forEach((p) => {
      const chu = (p.textContent || "").replace(/\s+/g, " ").trim();
      if (!chu) return;
      // Dòng ngắn mà không kết thúc bằng dấu câu thì là tựa, không phải câu
      // văn — bỏ qua, trừ khi cả bài chẳng có gì khác để lấy.
      const la_tua = chu.length < 60 && !/[.!?…]$/.test(chu);
      if (la_tua && doan.length === 0) return;
      doan.push(chu);
    });

    const gom = doan.join(" ").trim();
    if (gom) return gom;
    // Cả bài toàn dòng ngắn: đành lấy nguyên chữ trong ô.
    return (vung.textContent || "").replace(/\s+/g, " ").trim();
  }

  function veLaiSEO() {
    const tieu_de = o("o-tieu-de").value.trim();
    o("o-seo-tieu-de").value = tieu_de ? tieu_de + DUOI_TIEU_DE : "";
    if (!tay["o-the-tieu-de"]) o("o-the-tieu-de").value = tieu_de;

    const mo_ta = catMoTa(nguonMoTa(), 160);
    o("o-seo-mo-ta").value = mo_ta;
    if (!tay["o-the-mo-ta"]) o("o-the-mo-ta").value = mo_ta;

    veLaiDem();
  }

  // Đếm ký tự cho mấy ô có data-dem, và bôi đỏ khi vượt mức. Mô tả dài quá
  // thì Google cắt ngang, ngắn quá thì nó bỏ luôn không dùng.
  function veLaiDem() {
    document.querySelectorAll<HTMLElement>("[data-dem]").forEach((el_o) => {
      const muc = Number(el_o.getAttribute("data-dem"));
      const dai = ((el_o as HTMLInputElement).value || "").length;
      let dem = el_o.nextElementSibling as HTMLElement | null;
      if (!dem || !dem.classList.contains("qt-dem")) {
        dem = document.createElement("p");
        dem.className = "qt-dem";
        el_o.after(dem);
      }
      dem.textContent = dai + "/" + muc + " ký tự";
      dem.classList.toggle("qt-dem-qua", dai > muc);
    });
  }

  function docForm() {
    return {
      slug: o("o-slug").value.trim(),
      tieu_de: o("o-tieu-de").value.trim(),
      nhan: o("o-nhan").value.trim() || null,
      lead: o("o-lead").value.trim() || null,
      than_bai: bo_soan ? bo_soan.layHTML() : "",
      // Mỗi dòng một tài liệu. Dòng trống bị bỏ, nên xuống dòng thừa không
      // sinh ra mục rỗng trong danh sách đánh số.
      tai_lieu: o("o-tai-lieu").value.split("\n").map((d) => d.trim()).filter(Boolean),
      anh: o("o-anh").value.trim() || null,
      anh_alt: o("o-anh-alt").value.trim() || null,
      anh_rong: Number(o("o-anh-rong").value) || null,
      anh_cao: Number(o("o-anh-cao").value) || null,
      ngay_dang: o("o-ngay").value || new Date().toISOString().slice(0, 10),
      noi_bat: o("o-noi-bat").checked,
      an: o("o-an").checked,
      the_tieu_de: o("o-the-tieu-de").value.trim() || null,
      the_mo_ta: o("o-the-mo-ta").value.trim() || null,
      seo_tieu_de: o("o-seo-tieu-de").value.trim() || null,
      seo_mo_ta: o("o-seo-mo-ta").value.trim() || null,
    };
  }

  /** Đổ một khối dữ liệu (bản nháp hoặc bản đã đăng) vào form. */
  function dienForm(d: Record<string, any>) {
    o("o-tieu-de").value = d.tieu_de ?? "";
    o("o-slug").value = d.slug ?? "";
    o("o-nhan").value = d.nhan ?? "";
    o("o-lead").value = d.lead ?? "";
    o("o-anh").value = d.anh ?? "";
    o("o-anh-alt").value = d.anh_alt ?? "";
    o("o-anh-rong").value = d.anh_rong ?? "";
    o("o-anh-cao").value = d.anh_cao ?? "";
    o("o-ngay").value = d.ngay_dang ?? "";
    o("o-noi-bat").checked = !!d.noi_bat;
    o("o-an").checked = !!d.an;
    o("o-tai-lieu").value = (d.tai_lieu ?? []).join("\n");
    o("o-the-tieu-de").value = d.the_tieu_de ?? "";
    o("o-the-mo-ta").value = d.the_mo_ta ?? "";
    o("o-seo-tieu-de").value = d.seo_tieu_de ?? "";
    o("o-seo-mo-ta").value = d.seo_mo_ta ?? "";
    if (bo_soan) bo_soan.datHTML(d.than_bai ?? "");
    veXemAnh();
  }

  /** Ghi nhận "form hiện tại đã lưu rồi", rồi vẽ lại đầu trang. */
  function datMocSach() {
    moc_sach = JSON.stringify(docForm());
    veLaiDauTrang();
  }

  function coThayDoi() {
    return JSON.stringify(docForm()) !== moc_sach;
  }

  /**
   * Bật/tắt gõ cho cả form. Dùng khi xem "Bản đã đăng": đó là ảnh chụp bản
   * trên web, gõ vào đó thì gõ vào hư không — mà không có gì báo cho biết.
   */
  function datKhoaForm(khoa: boolean) {
    el("man-chinh")
      .querySelectorAll<HTMLInputElement>("main input, main textarea, main select, main button")
      .forEach((e) => { e.disabled = khoa; });
    const vung = el("khung-soan").querySelector(".st-vung") as HTMLElement | null;
    if (vung) vung.contentEditable = khoa ? "false" : "true";
    el("khung-soan").classList.toggle("qt-khoa", khoa);
  }

  /**
   * Vẽ lại phần đầu trang cho khớp trạng thái.
   *
   * Quy tắc một nút: còn thay đổi chưa lưu thì chỉ hiện "Lưu"; lưu xong,
   * nếu có gì đó chưa lên web thì chỉ hiện "Đăng". Không bao giờ cả hai.
   */
  function veLaiDauTrang() {
    const xem_ban_web = che_do === "dang";
    const doi = coThayDoi() && !xem_ban_web;
    // Có thứ chưa lên web: bài chưa đăng bao giờ, hoặc bài đã đăng mà đang
    // treo một bản sửa.
    const cho_dang = !!id_bai && (!bai_da_dang || co_ban_nhap);

    el("nut-luu").hidden = !doi;
    el("nut-dang").hidden = doi || !cho_dang || xem_ban_web;
    el("nut-bo-nhap").hidden = !co_ban_nhap || doi;

    // Hai chế độ chỉ có nghĩa khi thật sự tồn tại hai bản khác nhau.
    el("chon-che-do").hidden = !(bai_da_dang && co_ban_nhap);
    el("nut-xem-nhap").classList.toggle("qt-che-do-chon", che_do === "nhap");
    el("nut-xem-dang").classList.toggle("qt-che-do-chon", che_do === "dang");

    el("tieu-de-man").textContent = !id_bai
      ? "Viết bài mới"
      : xem_ban_web
        ? "Bản đã đăng (chỉ xem)"
        : bai_da_dang
          ? co_ban_nhap ? "Bản đang sửa, chưa lên web" : "Sửa bài đang hiện trên web"
          : "Bản nháp, chưa lên web";
  }

  /** Đổi giữa xem bản đã đăng và bản đang sửa. */
  function doiCheDo(sang: "nhap" | "dang") {
    if (sang === che_do) return;
    // Rời bản đang sửa mà còn thay đổi chưa lưu thì mất, nên hỏi trước.
    if (sang === "dang" && coThayDoi()) {
      if (!confirm("Còn thay đổi chưa lưu. Xem bản đã đăng sẽ mất phần vừa gõ. Tiếp?")) return;
    }
    che_do = sang;
    if (sang === "dang") {
      dienForm(ban_tren_web ?? {});
      datKhoaForm(true);
    } else {
      dienForm(ban_nhap_hien ?? ban_tren_web ?? {});
      datKhoaForm(false);
      moc_sach = JSON.stringify(docForm());
    }
    veLaiDauTrang();
  }

  /** Dịch lỗi Postgres ra tiếng người. Trùng đường dẫn là lỗi hay gặp nhất. */
  function baoLoiGhi(error: { code?: string; message: string }, slug: string) {
    bao(
      error.code === "23505"
        ? 'Đường dẫn "' + slug + '" đã có bài khác dùng rồi. Đổi sang chữ khác.'
        : "Không lưu được: " + error.message,
      true
    );
  }

  /**
   * Lưu — KHÔNG đăng, không đụng vào bản đang chạy trên web.
   *
   * Bài chưa đăng: ghi thẳng vào bài, vì chính nó đã là bản nháp.
   * Bài đã đăng: ghi sang bảng ban_nhap, bài trên web nguyên vẹn.
   */
  async function luu() {
    const d = docForm();
    if (!d.tieu_de || !d.slug) {
      bao("Cần có tiêu đề và đường dẫn.", true);
      return;
    }

    if (!id_bai) {
      const { data, error } = await supabase
        .from("bai_viet").insert({ ...d, da_dang: false }).select("id").single();
      if (error) return baoLoiGhi(error, d.slug);
      // Gắn id vào địa chỉ để lần lưu sau là sửa chứ không tạo thêm bài.
      id_bai = data.id;
      history.replaceState(null, "", "/admin/bai?id=" + id_bai);
      bai_da_dang = false;
      vet("đã tạo bài mới", { id_bai });
    } else if (bai_da_dang) {
      const { error } = await supabase
        .from("ban_nhap")
        .upsert({ bai_id: id_bai, du_lieu: d }, { onConflict: "bai_id" });
      if (error) return baoLoiGhi(error, d.slug);
      co_ban_nhap = true;
      ban_nhap_hien = d;
      vet("đã lưu bản sửa của bài đã đăng");
    } else {
      const { error } = await supabase
        .from("bai_viet").update({ ...d, da_dang: false }).eq("id", id_bai);
      if (error) return baoLoiGhi(error, d.slug);
      vet("đã lưu bài chưa đăng");
    }

    bao(bai_da_dang ? "Đã lưu bản sửa. Bài trên web vẫn là bản cũ." : "Đã lưu.");
    datMocSach();
  }

  /**
   * Đăng — đưa bản đang sửa lên web.
   *
   * Bài đã đăng thì bản sửa đang nằm ở ban_nhap: chép sang bài, rồi xoá
   * nháp đi. Nhân đây đặt ngay_sua = hôm nay, vì đó là mốc Google nhìn thấy
   * qua dateModified; đăng bản sửa mà không dời mốc thì Google vẫn tưởng
   * bài y như cũ.
   */
  async function dang() {
    const d = docForm();
    if (!d.tieu_de || !d.slug) {
      bao("Cần có tiêu đề và đường dẫn.", true);
      return;
    }
    if (!id_bai) {
      bao("Lưu bài trước đã.", true);
      return;
    }

    const ban_ghi: Record<string, unknown> = { ...d, da_dang: true };
    // Bài đăng lần đầu thì chưa có gì để "sửa", để trống cho đúng.
    if (bai_da_dang) ban_ghi.ngay_sua = new Date().toISOString().slice(0, 10);

    const { error } = await supabase.from("bai_viet").update(ban_ghi).eq("id", id_bai);
    if (error) return baoLoiGhi(error, d.slug);

    if (co_ban_nhap) {
      const { error: loi_xoa } = await supabase
        .from("ban_nhap").delete().eq("bai_id", id_bai);
      // Bài đã lên web rồi, nên nháp sót lại chỉ là rác chứ không sai nội
      // dung. Nói ra để biết, đừng làm người viết tưởng đăng thất bại.
      if (loi_xoa) bao("Đã đăng, nhưng bản nháp cũ chưa xoá được: " + loi_xoa.message, true);
      co_ban_nhap = false;
    }

    // Bản vừa đăng giờ CHÍNH LÀ bản trên web, và không còn bản sửa nào treo.
    bai_da_dang = true;
    ban_tren_web = d;
    ban_nhap_hien = null;
    bao("Đã đăng bài.");
    datMocSach();
  }

  /** Bỏ bản sửa đang treo, quay về đúng bản đang chạy trên web. */
  async function boBanNhap() {
    if (!id_bai || !co_ban_nhap) return;
    if (!confirm("Bỏ bản đang sửa và quay về bản đã đăng? Không lấy lại được.")) return;
    const { error } = await supabase.from("ban_nhap").delete().eq("bai_id", id_bai);
    if (error) {
      bao("Không bỏ được bản sửa: " + error.message, true);
      return;
    }
    co_ban_nhap = false;
    bao("Đã bỏ bản sửa.");
    location.reload();
  }

  async function nap() {
    vet("nap() bắt đầu", { id_bai });
    const { data: phien_data } = await supabase.auth.getSession();
    const phien = phien_data.session;
    if (!phien) {
      vet("không có phiên → về /admin");
      location.href = "/admin";
      return;
    }
    vet("có phiên", { tai_khoan: phien.user.user_metadata?.user_name });
    el("nhan-tai-khoan").textContent = String(
      phien.user.user_metadata?.user_name ?? phien.user.email ?? ""
    );

    if (!(window as any).SoanThao) {
      vet("THIẾU window.SoanThao — admin-soan-thao.js không nạp được");
      bao("Không dựng được khung soạn thảo. Tải lại trang thử xem.", true);
    }
    bo_soan = (window as any).SoanThao.tao({
      khung: el("khung-soan"),
      khiChonAnh: () => alert("Kho ảnh sẽ làm ở bước sau."),
    });
    vet("đã dựng trình soạn thảo");
    // Ghi rõ "từ" và "ký tự" thành hai số riêng. Nhãn cũ ghi "Khoảng N chữ"
    // mà đếm theo TỪ — gõ liền sáu ký tự không dấu cách thì nó đứng ở 1, ai
    // nhìn cũng tưởng ô soạn thảo hỏng.
    bo_soan.khiDoi(() => {
      const vung = el("khung-soan").querySelector(".st-vung") as HTMLElement;
      const ky_tu = (vung?.textContent || "").trim().length;
      el("dem-chu").textContent =
        "Khoảng " + bo_soan.demChu() + " từ · " + ky_tu + " ký tự.";
      // Thân bài cũng là nguồn sinh mô tả khi đoạn mở đầu bỏ trống.
      veLaiSEO();
    });

    o("o-tieu-de").addEventListener("input", veLaiSEO);
    o("o-lead").addEventListener("input", veLaiSEO);

    if (id_bai) {
      // Đọc một lượt cả bài trên web và bản sửa đang treo. Bản sửa chỉ tồn
      // tại với bài đã đăng, nên bảng ban_nhap thường là rỗng.
      const [{ data, error }, { data: nhap }] = await Promise.all([
        supabase.from("bai_viet").select("*").eq("id", id_bai).single(),
        supabase.from("ban_nhap").select("du_lieu").eq("bai_id", id_bai).maybeSingle(),
      ]);
      if (error || !data) {
        bao("Không mở được bài này: " + (error?.message ?? "không tìm thấy"), true);
      } else {
        bai_da_dang = !!data.da_dang;
        ban_tren_web = data;
        // Nháp của bài chưa đăng là rác sót lại (bài từng đăng rồi bị gỡ
        // về nháp). Bỏ qua, kẻo hiện hai bản mà thật ra chỉ có một.
        co_ban_nhap = bai_da_dang && !!nhap?.du_lieu;
        ban_nhap_hien = co_ban_nhap ? nhap!.du_lieu : null;

        el("duong-dan-xem").textContent = "/" + data.slug;
        // Mở ra là thấy bản đang sửa — đó là bản người viết đang làm việc.
        dienForm(ban_nhap_hien ?? data);
        vet("đã nạp bài", { bai_da_dang, co_ban_nhap });

        // Chữ trên thẻ đã có sẵn trong bài cũ thì coi như người viết đã
        // chọn — đừng để máy điền đè khi sửa lại tiêu đề.
        const nguon = ban_nhap_hien ?? data;
        if (nguon.the_tieu_de) tay["o-the-tieu-de"] = true;
        if (nguon.the_mo_ta) tay["o-the-mo-ta"] = true;
      }
    } else {
      o("o-ngay").value = new Date().toISOString().slice(0, 10);
      // Bài mới: đường dẫn chạy theo tiêu đề cho tới khi người viết sửa tay.
      let slug_tay = false;
      o("o-slug").addEventListener("input", () => { slug_tay = true; });
      o("o-tieu-de").addEventListener("input", () => {
        if (!slug_tay) o("o-slug").value = tenFile(o("o-tieu-de").value);
      });
    }

    // Chạy một lượt sau khi form đã có dữ liệu: bài cũ thiếu mô tả Google
    // (như mấy bài đăng trước khi có phần này) sẽ được điền ngay.
    veLaiSEO();
    veXemAnh();

    // Đặt mốc SAU khi veLaiSEO() đã điền xong, không thì mấy ô SEO máy tự
    // điền bị tính là "thay đổi chưa lưu" và nút Lưu hiện ra ngay lúc mở
    // bài, chưa ai gõ gì cả.
    datMocSach();

    el("man-cho").hidden = true;
    el("man-chinh").hidden = false;
    vet("nap() xong, form đã hiện");
  }

  el("nut-quay-lai").addEventListener("click", () => { location.href = "/admin"; });
  el("nut-luu").addEventListener("click", luu);
  el("nut-dang").addEventListener("click", dang);
  el("nut-bo-nhap").addEventListener("click", boBanNhap);
  el("nut-xem-dang").addEventListener("click", () => doiCheDo("dang"));
  el("nut-xem-nhap").addEventListener("click", () => doiCheDo("nhap"));

  // Gõ hay bấm gì trong form cũng phải soi lại hai cái nút. Bắt ở khung
  // ngoài thay vì gắn vào từng ô: thêm ô mới sau này khỏi phải nhớ gắn.
  ["input", "change"].forEach((ten) =>
    el("man-chinh").addEventListener(ten, () => veLaiDauTrang())
  );

  // Rời trang mà còn thay đổi chưa lưu thì trình duyệt hỏi lại. Mất một bài
  // vừa soạn vì bấm nhầm nút Quay lại là chuyện không sửa lại được.
  window.addEventListener("beforeunload", (e) => {
    if (che_do === "nhap" && moc_sach && coThayDoi()) e.preventDefault();
  });

  nap();
</script>

</body>
</html>
