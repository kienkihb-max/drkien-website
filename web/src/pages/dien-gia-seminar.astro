---
// Trang này chuyển từ dien-gia-seminar.html của site tĩnh cũ.
// Toàn bộ thẻ SEO nay do layouts/Trang.astro sinh — sửa tiêu đề hay mô tả
// thì sửa ở mấy dòng thuộc tính ngay dưới đây, đừng thêm thẻ meta vào thân.
import Trang from "../layouts/Trang.astro";
import DuongDan from "../components/DuongDan.astro";
import { timDichVu } from "../data/dich-vu.mjs";
import BaiCuaDichVu from "../components/BaiCuaDichVu.astro";
import ServiceCardsRelated from "../components/ServiceCardsRelated.astro";
---

<Trang
  tieu_de="Diễn giả seminar sức khỏe — Bác sĩ Lê Trung Kiên"
  mo_ta="Mời bác sĩ Lê Trung Kiên làm diễn giả chia sẻ kiến thức chăm sóc sức khỏe, sơ cấp cứu và phòng ngừa chấn thương tại workshop, seminar cho doanh nghiệp, trường học."
  duong_dan="dien-gia-seminar"
  anh="assets/img/community-firstaid-demo.jpg"
  anh_alt="Bác sĩ Lê Trung Kiên hướng dẫn sơ cấp cứu tại buổi chia sẻ cộng đồng"
  loai_trang="service"
  lop_body="subpage"
  scripts={["thong-tin.js","seo-schema.js","sticky-cta.js"]}
>
<section class="section cv-hero">
    <div class="container">
      <DuongDan hien_tai={timDichVu("dien-gia-seminar").ten} />
      <h1>Diễn giả tại workshop, seminar sức khỏe</h1>
      <p class="lead">
        Với nền tảng chuyên môn Y học cổ truyền và kinh nghiệm giảng dạy tại các trường y dược,
        mình nhận chia sẻ chuyên môn tại các buổi workshop, seminar chăm sóc sức khỏe cho doanh
        nghiệp, trường học và cộng đồng — nội dung linh hoạt theo đối tượng người nghe, từ buổi
        nói chuyện ngắn đến workshop thực hành sơ cứu tại chỗ.
      </p>
      <div class="offer-actions">
        <a class="btn btn-primary btn-icon" data-tt-href="zalo">
          Mời diễn giả / Liên hệ hợp tác <svg class="icon icon-sm"><use href="#ic-arrow"/></svg>
        </a>
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <div class="section-title text-center">
        <p class="section-label">Chuyên môn</p>
        <h2>Nội dung có thể chia sẻ</h2>
        <div class="divider mx-auto"></div>
      </div>
      <div class="content-media-grid">
        <div class="info-card">
          <ul class="list-check">
            <li>Kiến thức y học cổ truyền, châm cứu trong hỗ trợ giảm đau, phục hồi vận động</li>
            <li>Chăm sóc cột sống, phòng đau cổ vai gáy cho dân văn phòng</li>
            <li>Phòng ngừa chấn thương khi tập luyện, chơi thể thao</li>
            <li>Sơ cấp cứu cơ bản, xử trí tai nạn thương tích tại nơi làm việc</li>
          </ul>
        </div>
        <!-- Clip hướng dẫn băng ép cẳng tay, nhúng từ Facebook của bác sĩ.
             Trước đây chỗ này là ảnh community-firstaid-demo.jpg; ảnh đó vẫn
             dùng làm ảnh chia sẻ của trang (thuộc tính anh= ở trên), đừng xoá.

             Link gốc: https://www.facebook.com/reel/1114262207798058
             Đổi clip thì sửa số reel trong src bên dưới. Clip phải để chế độ
             công khai, không thì khung này hiện trắng.

             loading="lazy" để trình duyệt chỉ gọi sang Facebook khi người đọc
             cuộn tới — đây là khung nhúng của bên thứ ba, nạp ngay từ đầu là
             trang chậm đi và Facebook biết mọi lượt ghé trang. -->
        <div class="content-media-single">
          <div class="clip-doc">
            <iframe
              src="https://www.facebook.com/plugins/video.php?href=https%3A%2F%2Fwww.facebook.com%2Freel%2F1114262207798058&show_text=false"
              title="Bác sĩ Lê Trung Kiên hướng dẫn băng ép cẳng tay khi sơ cứu"
              loading="lazy"
              allow="autoplay; clipboard-write; encrypted-media; picture-in-picture; web-share"
              allowfullscreen
              scrolling="no"
              frameborder="0"
            ></iframe>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-title text-center">
        <p class="section-label">Đã tham gia</p>
        <h2>Một số buổi chia sẻ đã thực hiện</h2>
        <div class="divider mx-auto"></div>
      </div>
      <div class="events-grid events-grid-2col">
        <div class="event-card">
          <div class="event-img"><img src="/assets/img/speak-wetas-marathon-wellbeing.jpg" alt="Bác sĩ Lê Trung Kiên làm khách mời talkshow trực tuyến Giải mã sức mạnh Well-being của Marathon, chuỗi weTAS Hơn cả chạy bộ của Techcombank Hanoi International Marathon" loading="lazy"></div>
          <h3>Talkshow &quot;Hơn cả chạy bộ&quot; — Techcombank Hanoi Marathon</h3>
          <p>Khách mời talkshow trực tuyến &quot;Giải mã sức mạnh Well-being của Marathon&quot; trong chuỗi weTAS Hơn cả chạy bộ.</p>
        </div>
        <div class="event-card">
          <div class="event-img"><img src="/assets/img/speak-hoithi-sangtao-baocao.jpg" alt="Bác sĩ Lê Trung Kiên báo cáo trước hội đồng chấm thi tại Hội thi Kỹ thuật sáng tạo tuổi trẻ ngành Y tế khu vực Hà Nội lần thứ 30" loading="lazy"></div>
          <h3>Hội thi Kỹ thuật sáng tạo tuổi trẻ ngành Y tế</h3>
          <p>Báo cáo viên tại Hội thi Kỹ thuật sáng tạo tuổi trẻ ngành Y tế khu vực Hà Nội lần thứ 30.</p>
        </div>
        <div class="event-card">
          <div class="event-img"><img src="/assets/img/community-seminar-tigren.jpg" alt="Bác sĩ Lê Trung Kiên cùng toàn thể nhân viên Tigren sau seminar Các vấn đề về cột sống của dân văn phòng" loading="lazy"></div>
          <h3>Seminar cột sống — Tigren</h3>
          <p>Seminar "Các vấn đề về cột sống của dân văn phòng" cho toàn thể nhân viên Tigren.</p>
        </div>
        <div class="event-card">
          <div class="event-img"><img src="/assets/img/community-firstaid-training.jpg" alt="Hội nghị tập huấn sơ cấp cứu, phòng tránh tai nạn thương tích ở trẻ em, phường Mai Dịch" loading="lazy"></div>
          <h3>Tập huấn sơ cấp cứu — Mai Dịch</h3>
          <p>Hội nghị tập huấn sơ cấp cứu, phòng tránh tai nạn thương tích ở trẻ em, phường Mai Dịch.</p>
        </div>
      </div>
    </div>
  </section>

  <BaiCuaDichVu dich_vu="dien-gia-seminar" nen_xam />

  {/* Khối tự suy ra nền xám của nó từ articlesAlt — xem ServiceCardsRelated */}
  <ServiceCardsRelated service="dien-gia-seminar" articlesAlt />
</Trang>

<style>
  /* Hai cột lệch nhau: clip dọc 9:16 luôn cao hơn hẳn mấy dòng gạch đầu
     dòng bên trái. Nếu để lưới kéo giãn (mặc định là stretch) thì ô chữ
     bị bơm cao bằng clip và thừa ra một mảng trắng trống. Nên:
     — căn giữa theo chiều dọc, ô chữ chỉ cao bằng nội dung thật của nó;
     — chặn chiều cao clip, không chặn chiều rộng, để clip không vống lên. */
  .content-media-grid {
    align-items: center;
  }

  /* Khung clip dọc 9:16 (clip gốc 720x1280). Chặn cao 460px → rộng khoảng
     260px, xấp xỉ chiều cao ô chữ bên cạnh. */
  .clip-doc {
    aspect-ratio: 9 / 16;
    max-height: 460px;
    margin: 0 auto;
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--shadow-card);
    /* Nền đen để lúc clip chưa tải xong không phải một ô trắng trống. */
    background: #000;
  }
  .clip-doc iframe {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
  }

  /* Điện thoại xếp một cột nên không còn chuyện lệch hai bên nữa —
     thả chặn cao ra, cho clip rộng gần hết màn cho dễ xem. */
  @media (max-width: 720px) {
    .clip-doc {
      max-height: none;
      max-width: 340px;
    }
  }
</style>
