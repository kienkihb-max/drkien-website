---
// Trang này chuyển từ index.html của site tĩnh cũ.
// Toàn bộ thẻ SEO nay do layouts/Trang.astro sinh — sửa tiêu đề hay mô tả
// thì sửa ở mấy dòng thuộc tính ngay dưới đây, đừng thêm thẻ meta vào thân.
import Trang from "../layouts/Trang.astro";
---

<Trang
  tieu_de="Bác sĩ Lê Trung Kiên — ThS.BS Y học cổ truyền & Y tế thể thao"
  mo_ta="Bác sĩ Lê Trung Kiên (ThS.BS) — bác sĩ Y học cổ truyền tại Hà Nội, làm y tế sự kiện thể thao và diễn giả sức khỏe. Châm cứu, vật lý trị liệu, phục hồi chấn thương thể thao."
  duong_dan=""
  anh="assets/img/og-share.jpg"
  anh_alt="Bác sĩ Lê Trung Kiên — ThS. Y học cổ truyền, Bệnh viện Đa khoa Y học cổ truyền Hà Nội"
  loai_trang="home"
  scripts={["thong-tin.js","seo-schema.js","service-cards.js","lightbox.js","script.js"]}
>
<section class="hero" id="home">
    <div class="container hero-inner">
      <div class="hero-text">
        <div class="eyebrow-row">
          <span class="mini-divider"></span>
          <span class="eyebrow">Y học cổ truyền · Y tế thể thao · Diễn giả sức khỏe</span>
        </div>
        <h1>Đồng hành sức khỏe, từ phòng khám đến sân đấu</h1>
        <p class="hero-lead">
          Mình là <strong>bác sĩ Lê Trung Kiên</strong> — Thạc sĩ Y học cổ truyền, đồng thời là người đồng hành y tế
          tại các sự kiện thể thao và diễn giả sức khỏe. Dù bạn cần điều trị đau cơ xương khớp,
          tìm bác sĩ đồng hành tại giải đấu, hay mời chuyên gia chia sẻ tại sự kiện — mình đều
          có thể hỗ trợ.
        </p>
        <div class="hero-actions">
          <a class="btn btn-primary btn-icon" data-tt-href="zalo">
            Nhắn Zalo: 034 590 1772 <svg class="icon icon-sm"><use href="#ic-arrow"/></svg>
          </a>
          <a class="btn btn-outline" href="#offerings">Xem dịch vụ</a>
        </div>
      </div>
      <div class="hero-media">
        <div class="hero-media-blob"></div>
        <img src="/assets/img/portrait.jpg" alt="Bác sĩ Lê Trung Kiên — ThS.BS Y học cổ truyền, Bệnh viện Đa khoa Y học cổ truyền Hà Nội" width="480" height="480">
        <div class="hero-media-overlay"></div>
      </div>
    </div>
  </section>

  <section id="offerings" class="section offerings-section">
    <div class="container">
      <div class="section-title text-center">
        <p class="section-label">Dịch vụ</p>
        <h2>Mình có thể hỗ trợ bạn</h2>
        <div class="divider mx-auto"></div>
      </div>
      <!-- Thẻ dịch vụ do service-cards.js dựng — sửa nội dung trong file đó -->
      <div class="offer-grid service-cards"></div>
    </div>
  </section>

  <section id="experience" class="section">
    <div class="container">
      <div class="section-title text-center">
        <p class="section-label">Kinh nghiệm &amp; học vấn</p>
        <h2>Nền tảng chuyên môn</h2>
        <div class="divider mx-auto"></div>
      </div>
      <figure class="cv-photo">
        <img src="/assets/img/graduation.jpg" alt="Lễ tốt nghiệp và trao bằng Thạc sĩ, Trường Đại học Y Hà Nội, 07-08/04/2026" loading="lazy">
      </figure>
      <div class="cards-2col">
        <div class="info-card">
          <h3>Công tác</h3>
          <ul class="list-check">
            <li>Bác sĩ, Khoa Ngoại, Bệnh viện Đa khoa Y học cổ truyền Hà Nội (2020 – 2026)</li>
            <li>Bác sĩ, Phòng Đào tạo, Nghiên cứu khoa học và Chỉ đạo tuyến, Bệnh viện Đa khoa Y học cổ truyền Hà Nội (2026 – nay)</li>
            <li>Giảng viên thỉnh giảng chuyên ngành Y học cổ truyền</li>
          </ul>
        </div>
        <div class="info-card">
          <h3>Học vấn</h3>
          <ul class="list-check">
            <li>Thạc sĩ Y học cổ truyền — Đại học Y Hà Nội (2025)</li>
            <li>Bác sĩ Y học cổ truyền — Học viện Y Dược học cổ truyền Việt Nam (2018)</li>
            <li>Chứng chỉ Sư phạm Y học — Đại học Y Hà Nội (2025)</li>
          </ul>
        </div>
      </div>
      <p class="cv-link-wrap">
        <a class="cv-link" href="/bac-si-le-trung-kien">Xem tất cả <svg class="icon icon-sm"><use href="#ic-arrow"/></svg></a>
      </p>
    </div>
  </section>

  <section id="stories" class="section">
    <div class="container">
      <div class="section-title text-center">
        <p class="section-label">Bệnh nhân nói gì</p>
        <h2>Chia sẻ từ bệnh nhân</h2>
        <div class="divider mx-auto"></div>
      </div>
      <div class="shots-marquee">
        <div class="shots-track">
          <div class="shots-grid" id="shotsGrid">
            <figure class="shot-card">
              <div class="shot-thumb"><img src="/assets/img/testimonial-1-zalo-neck-headache-thumb.jpg" data-full="/assets/img/testimonial-1-zalo-neck-headache.jpg" alt="Tin nhắn Zalo bệnh nhân đau cổ gáy, đau đầu, chóng mặt sau 4 buổi điều trị bằng châm cứu" loading="lazy"></div>
            </figure>
            <figure class="shot-card">
              <div class="shot-thumb"><img src="/assets/img/testimonial-2-zalo-backpain-thumb.jpg" data-full="/assets/img/testimonial-2-zalo-backpain.jpg" alt="Tin nhắn Zalo bệnh nhân đau lưng cấp do thoát vị đĩa đệm cột sống thắt lưng" loading="lazy"></div>
            </figure>
            <figure class="shot-card">
              <div class="shot-thumb"><img src="/assets/img/testimonial-3-zalo-neckshoulder-thumb.jpg" data-full="/assets/img/testimonial-3-zalo-neckshoulder.jpg" alt="Tin nhắn Zalo bệnh nhân đau cổ vai gáy sau 3 buổi châm cứu" loading="lazy"></div>
            </figure>
            <figure class="shot-card">
              <div class="shot-thumb"><img src="/assets/img/testimonial-4-zalo-achilles-thumb.jpg" data-full="/assets/img/testimonial-4-zalo-achilles.jpg" alt="Tin nhắn Zalo bệnh nhân viêm gân chày sau, đã hoàn thành marathon sub 4 giờ" loading="lazy"></div>
            </figure>
            <figure class="shot-card">
              <div class="shot-thumb"><img src="/assets/img/testimonial-5-fb-hoavu-thumb.jpg" data-full="/assets/img/testimonial-5-fb-hoavu.jpg" alt="Bài đăng Facebook của một runner cảm ơn bác sĩ Kiên đã đồng hành hồi phục" loading="lazy"></div>
            </figure>
            <figure class="shot-card">
              <div class="shot-thumb"><img src="/assets/img/testimonial-6-fb-ngocphuong.jpg" alt="Bài đăng Facebook chia sẻ hành trình điều trị chấn thương khi chạy bộ" loading="lazy"></div>
            </figure>
            <figure class="shot-card">
              <div class="shot-thumb"><img src="/assets/img/testimonial-7-fb-vanquang.jpg" alt="Bài đăng Facebook giới thiệu bác sĩ Kiên đồng hành cùng cộng đồng chạy bộ" loading="lazy"></div>
            </figure>
          </div>
          <div class="shots-grid" aria-hidden="true">
            <figure class="shot-card">
              <div class="shot-thumb"><img src="/assets/img/testimonial-1-zalo-neck-headache-thumb.jpg" data-full="/assets/img/testimonial-1-zalo-neck-headache.jpg" alt="" loading="lazy"></div>
            </figure>
            <figure class="shot-card">
              <div class="shot-thumb"><img src="/assets/img/testimonial-2-zalo-backpain-thumb.jpg" data-full="/assets/img/testimonial-2-zalo-backpain.jpg" alt="" loading="lazy"></div>
            </figure>
            <figure class="shot-card">
              <div class="shot-thumb"><img src="/assets/img/testimonial-3-zalo-neckshoulder-thumb.jpg" data-full="/assets/img/testimonial-3-zalo-neckshoulder.jpg" alt="" loading="lazy"></div>
            </figure>
            <figure class="shot-card">
              <div class="shot-thumb"><img src="/assets/img/testimonial-4-zalo-achilles-thumb.jpg" data-full="/assets/img/testimonial-4-zalo-achilles.jpg" alt="" loading="lazy"></div>
            </figure>
            <figure class="shot-card">
              <div class="shot-thumb"><img src="/assets/img/testimonial-5-fb-hoavu-thumb.jpg" data-full="/assets/img/testimonial-5-fb-hoavu.jpg" alt="" loading="lazy"></div>
            </figure>
            <figure class="shot-card">
              <div class="shot-thumb"><img src="/assets/img/testimonial-6-fb-ngocphuong.jpg" alt="" loading="lazy"></div>
            </figure>
            <figure class="shot-card">
              <div class="shot-thumb"><img src="/assets/img/testimonial-7-fb-vanquang.jpg" alt="" loading="lazy"></div>
            </figure>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section id="credibility" class="section section-alt">
    <div class="container">
      <div class="section-title text-center">
        <p class="section-label">Ghi nhận &amp; báo chí</p>
        <h2>Uy tín chuyên môn</h2>
        <div class="divider mx-auto"></div>
      </div>
      <div class="awards-featured">
        <figure class="award-card award-featured">
          <div class="award-img"><img src="/assets/img/award-nguoitot-viectot.jpg" alt="Danh hiệu Người tốt việc tốt năm 2025, Sở Y tế Hà Nội" loading="lazy"></div>
          <figcaption>Danh hiệu "Người tốt, việc tốt" — Sở Y tế Hà Nội, 2025</figcaption>
        </figure>
        <figure class="award-card award-featured">
          <div class="award-img"><img src="/assets/img/award-bangkhen-sotay.jpg" alt="Bằng khen của UBND Thành phố Hà Nội" loading="lazy"></div>
          <figcaption>Bằng khen UBND TP. Hà Nội — Hội thi Kỹ thuật sáng tạo tuổi trẻ ngành Y tế, 2025</figcaption>
        </figure>
      </div>
