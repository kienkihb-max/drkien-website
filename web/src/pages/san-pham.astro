---
// Trang giới thiệu sản phẩm. Nội dung KHÔNG nằm ở đây — tên món và ảnh đọc
// từ data/san-pham.mjs. Sửa chữ thì sửa file đó.
//
// Thẻ SEO do layouts/Trang.astro sinh — đổi tiêu đề hay mô tả thì sửa mấy
// dòng thuộc tính của <Trang> ngay bên dưới, đừng thêm thẻ meta vào thân.
//
// Mỗi món CHỈ HIỆN TÊN, không có câu mô tả nào. Đây là yêu cầu của chủ site,
// không phải chỗ còn thiếu chữ — lý do chép đầy đủ ở đầu san-pham.mjs.
import Trang from "../layouts/Trang.astro";
import DuongDan from "../components/DuongDan.astro";
import ProductGrid from "../components/ProductGrid.astro";
import ServiceCardsRelated from "../components/ServiceCardsRelated.astro";
import { SAN_PHAM, TU_BAO_CHE, CHU_NUT_HOI } from "../data/san-pham.mjs";
import { TEN_BAC_SI } from "../data/thong-tin.mjs";
---

<Trang
  tieu_de="Sản phẩm Y học cổ truyền"
  mo_ta="Bột tam thất, thuốc thang, thuốc sắc, bột ngâm chân, cồn xoa bóp, thuốc ngâm rượu và các sản phẩm dưỡng sinh do bác sĩ Lê Trung Kiên tự bào chế tại phòng khám."
  duong_dan="san-pham"
  anh="assets/img/product-og.jpg"
  anh_alt="Bác sĩ Lê Trung Kiên cân dược liệu để bào chế chế phẩm Y học cổ truyền"
  loai_trang="service"
  lop_body="subpage"
  scripts={["thong-tin.js", "seo-schema.js", "sticky-cta.js"]}
>
  <section class="section cv-hero">
    <div class="container">
      <DuongDan hien_tai="Sản phẩm" />
      <h1>Sản phẩm Y học cổ truyền mình cung cấp</h1>
      <p class="lead">
        Ngoài việc thăm khám và điều trị, mình có bào chế một số chế phẩm quen dùng tại phòng
        khám, và một vài món dưỡng sinh dùng hằng ngày.
      </p>
      <div class="offer-actions">
        <a class="btn btn-primary btn-icon" data-tt-href="zalo">
          {CHU_NUT_HOI} <svg class="icon icon-sm"><use href="#ic-arrow"/></svg>
        </a>
      </div>
    </div>
  </section>

  {/* Khối giới thiệu: cùng lưới .runner-grid với trang điều trị, ảnh bên
      trái chữ bên phải. Ảnh dọc nên bọc trong .runner-media-featured để nó
      bo góc và đổ bóng giống mọi ảnh khác của site. */}
  <section class="section section-alt">
    <div class="container runner-grid">
      <div class="runner-media">
        <div class="runner-media-featured gioi-thieu-anh">
          <img
            src="/assets/img/product-bao-che.jpg"
            alt="Bác sĩ Lê Trung Kiên đeo găng, cân dược liệu trên cân điện tử tại phòng khám"
            loading="lazy"
          />
        </div>
      </div>
      <div>
        <p class="section-label">Tâm huyết của mình</p>
        <h2>Bắt đầu từ trong gia đình</h2>
        {/* Lời chủ site tự viết — để nghiêng và đặt trong ngoặc kép cho thấy
            rõ đây là lời kể của bác sĩ, không phải chữ quảng cáo. Ngoặc mở ở
            đoạn đầu, ngoặc đóng ở đoạn sau, đúng lối trích một đoạn liền. */}
        <p class="lead quote-story">
          “Mấy món này mình làm cho người nhà trước. Người nhà dùng thì không có chỗ cho hai
          chữ ‘tạm được’: dược liệu tự tay chọn, tự tay cân, làm từng mẻ nhỏ, mẻ nào cũng
          nhớ lấy ở đâu, đóng gói ngày nào. Rồi bạn bè hỏi mua, rồi người bệnh hỏi mua —
          mình vẫn làm y như hồi làm cho nhà mình, không bớt một bước. Đứng sau mỗi mẻ vẫn
          là thạc sĩ, bác sĩ, dược sĩ chuyên khoa Y học cổ truyền, đủ để mình biết đâu là
          giới hạn mà không hứa điều mình không chắc. Nên mình không nói đây là thứ thần kỳ.
          Chỉ là thứ mình yên tâm đưa cho người trong nhà dùng.”
        </p>
        {/* Tên lấy từ data/thong-tin.mjs — nguồn duy nhất, đừng gõ tay lại. */}
        <p class="quote-sign">— {TEN_BAC_SI}</p>
      </div>
    </div>
  </section>

  <section class="section" id={TU_BAO_CHE.ma}>
    <div class="container">
      <div class="section-title text-center">
        <p class="section-label">{TU_BAO_CHE.nhan}</p>
        <h2>{TU_BAO_CHE.tieu_de}</h2>
        <div class="divider mx-auto"></div>
      </div>

      {/* Thẻ sản phẩm dựng bằng component dùng chung — khối "Các sản phẩm
          khác" ở cuối mỗi trang chi tiết cũng dùng đúng component đó.
          Thứ tự hiện đúng thứ tự trong SAN_PHAM, món nào cần đứng trước thì
          xếp lên trên trong data/san-pham.mjs. */}
      <ProductGrid items={SAN_PHAM} />
    </div>
  </section>

  {/* Không còn khối "Nhận đặt hộ", cũng không còn dải nút "Liên hệ tư vấn"
      đứng một mình giữa trang — chủ site đã bỏ cả hai. Nút liên hệ vẫn có ở
      đầu trang và ở từng trang chi tiết sản phẩm. Đừng thêm lại. */}

  {/* Không có khối địa chỉ / giờ đón khách ở đây: chủ site đã bỏ. Hai thứ
      đó vẫn nằm sẵn ở chân trang trên mọi trang, lặp lại giữa trang chỉ
      làm dài thêm. Đừng thêm lại. */}

  {/* Trang này không phải trang dịch vụ nên không loại thẻ nào — hiện đủ 3.
      Sửa tên, mô tả, ảnh dịch vụ trong data/dich-vu.mjs. */}
  <ServiceCardsRelated />
</Trang>

<style>
  /* Mấy lớp dưới đây chỉ trang này dùng nên để trong <style> của trang, không
     thêm vào style.css: .info-card và các lưới chung đang được hơn 10 chỗ
     khác dùng, đụng vào đó là đổi luôn cả mấy trang kia.
     Astro tự giới hạn phạm vi khối này cho riêng trang. */

  /* Ảnh giới thiệu là ảnh dọc, mà .runner-media-featured mặc định xén theo
     khổ 16/10 rồi căn lên đỉnh — tức là chỉ còn cái đầu, mất hẳn hai tay và
     khay dược liệu, đúng phần đáng xem. Xén vuông và hạ tâm xuống 45% thì
     lấy trọn từ mặt tới cân. */
  .gioi-thieu-anh img {
    aspect-ratio: 1 / 1;
    object-position: center 45%;
  }

  /* Lời kể của bác sĩ trong khối "Cách mình làm". Chỉ nghiêng chữ, không đổi
     cỡ hay màu — .lead đã lo phần đó rồi. */
  .quote-story {
    font-style: italic;
  }

  /* Dòng ký tên dưới đoạn trích. Không nghiêng — để nó tách hẳn khỏi lời kể
     chứ không đọc tiếp như một câu nữa trong ngoặc kép. */
  .quote-sign {
    margin-top: 14px;
    font-family: "Be Vietnam Pro", system-ui, sans-serif;
    font-weight: 600;
    color: var(--primary);
  }


</style>
