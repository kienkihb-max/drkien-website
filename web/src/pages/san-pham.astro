---
// Trang giới thiệu sản phẩm. Nội dung KHÔNG nằm ở đây — tên món và ảnh đọc
// từ data/san-pham.mjs. Sửa chữ thì sửa file đó.
//
// Thẻ SEO do layouts/Trang.astro sinh — đổi tiêu đề hay mô tả thì sửa mấy
// dòng thuộc tính của <Trang> ngay bên dưới, đừng thêm thẻ meta vào thân.
//
// Mỗi món CHỈ HIỆN TÊN, không có câu mô tả nào. Đây là yêu cầu của chủ site,
// không phải chỗ còn thiếu chữ — lý do chép đầy đủ ở đầu san-pham.mjs.
import Trang from "../layouts/Trang.astro";
import DuongDan from "../components/DuongDan.astro";
import { SAN_PHAM, TU_BAO_CHE, CHU_NUT_HOI, CHU_BAN_CHAY } from "../data/san-pham.mjs";
import { TEN_BAC_SI } from "../data/thong-tin.mjs";
import {
  Leaf,
  Footprints,
  Droplets,
  BottleWine,
  FlaskConical,
  Flower2,
} from "@lucide/astro";

// Khai từng icon một chứ không nhập cả bộ Lucide — nhập cả bộ là kéo hơn
// 1800 icon vào lúc dựng. Thêm món mới với icon lạ thì thêm một dòng ở đây
// cho khớp trường "icon" trong san-pham.mjs, nếu không thẻ sẽ thiếu hình.
const ICON = { Leaf, Footprints, Droplets, BottleWine, FlaskConical, Flower2 };

---

<Trang
  tieu_de="Sản phẩm Y học cổ truyền"
  mo_ta="Bột tam thất, thuốc thang, thuốc sắc, bột ngâm chân, cồn xoa bóp, thuốc ngâm rượu và các sản phẩm dưỡng sinh do bác sĩ Lê Trung Kiên tự bào chế tại phòng khám."
  duong_dan="san-pham"
  anh="assets/img/product-og.jpg"
  anh_alt="Bác sĩ Lê Trung Kiên cân dược liệu để bào chế chế phẩm Y học cổ truyền"
  loai_trang="service"
  lop_body="subpage"
  scripts={["thong-tin.js", "seo-schema.js", "service-cards.js", "sticky-cta.js"]}
>
  <section class="section cv-hero">
    <div class="container">
      <DuongDan hien_tai="Sản phẩm" />
      <h1>Sản phẩm Y học cổ truyền mình cung cấp</h1>
      <p class="lead">
        Ngoài việc thăm khám và điều trị, mình có bào chế một số chế phẩm quen dùng tại phòng
        khám, và một vài món dưỡng sinh dùng hằng ngày.
      </p>
      <div class="offer-actions">
        <a class="btn btn-primary btn-icon" data-tt-href="zalo">
          {CHU_NUT_HOI} <svg class="icon icon-sm"><use href="#ic-arrow"/></svg>
        </a>
      </div>
    </div>
  </section>

  {/* Khối giới thiệu: cùng lưới .runner-grid với trang điều trị, ảnh bên
      trái chữ bên phải. Ảnh dọc nên bọc trong .runner-media-featured để nó
      bo góc và đổ bóng giống mọi ảnh khác của site. */}
  <section class="section section-alt">
    <div class="container runner-grid">
      <div class="runner-media">
        <div class="runner-media-featured gioi-thieu-anh">
          <img
            src="/assets/img/product-bao-che.jpg"
            alt="Bác sĩ Lê Trung Kiên đeo găng, cân dược liệu trên cân điện tử tại phòng khám"
            loading="lazy"
          />
        </div>
      </div>
      <div>
        <p class="section-label">Cách mình làm</p>
        <h2>Bắt đầu từ trong gia đình</h2>
        {/* Lời chủ site tự viết — để nghiêng và đặt trong ngoặc kép cho thấy
            rõ đây là lời kể của bác sĩ, không phải chữ quảng cáo. Ngoặc mở ở
            đoạn đầu, ngoặc đóng ở đoạn sau, đúng lối trích một đoạn liền. */}
        <p class="lead loi-ke">
          “Mấy món này mình làm cho người nhà trước. Người nhà dùng thì không có chỗ cho hai
          chữ ‘tạm được’: dược liệu tự tay chọn, tự tay cân, làm từng mẻ nhỏ, mẻ nào cũng
          nhớ lấy ở đâu, đóng gói ngày nào. Rồi bạn bè hỏi mua, rồi người bệnh hỏi mua —
          mình vẫn làm y như hồi làm cho nhà mình, không bớt một bước. Đứng sau mỗi mẻ vẫn
          là thạc sĩ, bác sĩ, dược sĩ chuyên khoa Y học cổ truyền, đủ để mình biết đâu là
          giới hạn mà không hứa điều mình không chắc. Nên mình không nói đây là thứ thần kỳ.
          Chỉ là thứ mình yên tâm đưa cho người trong nhà dùng.”
        </p>
        {/* Tên lấy từ data/thong-tin.mjs — nguồn duy nhất, đừng gõ tay lại. */}
        <p class="ky-ten">— {TEN_BAC_SI}</p>
      </div>
    </div>
  </section>

  <section class="section" id={TU_BAO_CHE.ma}>
    <div class="container">
      <div class="section-title text-center">
        <p class="section-label">{TU_BAO_CHE.nhan}</p>
        <h2>{TU_BAO_CHE.tieu_de}</h2>
        <div class="divider mx-auto"></div>
      </div>

      {/* Cả năm món trong MỘT lưới ba cột, thẻ nào cũng như thẻ nào. Trước
          đây tách hai hàng, món nổi bật để thẻ to hơn — nhìn lệch, và mỗi
          lần đổi số món lại phải sửa số cột của hai lưới cho khớp.
          Thứ tự hiện đúng theo thứ tự trong SAN_PHAM, món nào cần đứng
          trước thì xếp lên trên trong file đó. */}
      <div class="luoi-mon">
        {SAN_PHAM.map((m) => {
          const Icon = ICON[m.icon];
          return (
            <a class="mon" href={"/san-pham/" + m.slug}>
              {/* Món chưa có ảnh thì ô ảnh hiện icon trên nền nhạt, giữ đúng
                  khổ để lưới không so le. Có ảnh rồi thì thêm dòng anh/anh_alt
                  trong san-pham.mjs, không phải sửa ở đây. */}
              {m.anh ? (
                <img src={"/assets/img/" + m.anh} alt={m.anh_alt} loading="lazy" />
              ) : (
                <span class="mon-chua-anh">
                  {Icon && <Icon size={56} stroke-width={1.3} />}
                </span>
              )}
              {m.ban_chay && <span class="nhan-ban-chay">{CHU_BAN_CHAY}</span>}
              <h3 class="mon-ten">
                {Icon && <Icon size={19} stroke-width={1.8} />}
                {m.ten}
              </h3>
            </a>
          );
        })}
      </div>
    </div>
  </section>

  {/* Không còn khối "Nhận đặt hộ": chủ site đã bỏ. Đừng thêm lại. */}
  <section class="section section-alt">
    <div class="container">
      <p class="cv-link-wrap">
        <a class="btn btn-primary btn-icon" data-tt-href="zalo">
          {CHU_NUT_HOI} <svg class="icon icon-sm"><use href="#ic-arrow"/></svg>
        </a>
      </p>
    </div>
  </section>

  {/* Không có khối địa chỉ / giờ đón khách ở đây: chủ site đã bỏ. Hai thứ
      đó vẫn nằm sẵn ở chân trang trên mọi trang, lặp lại giữa trang chỉ
      làm dài thêm. Đừng thêm lại. */}

  {/* Nội dung do service-cards.js dựng — sửa danh sách dịch vụ trong dich-vu.mjs */}
  <section class="section service-related"></section>
</Trang>

<style>
  /* Mấy lớp dưới đây chỉ trang này dùng nên để trong <style> của trang, không
     thêm vào style.css: .info-card và các lưới chung đang được hơn 10 chỗ
     khác dùng, đụng vào đó là đổi luôn cả mấy trang kia.
     Astro tự giới hạn phạm vi khối này cho riêng trang. */

  /* Ảnh giới thiệu là ảnh dọc, mà .runner-media-featured mặc định xén theo
     khổ 16/10 rồi căn lên đỉnh — tức là chỉ còn cái đầu, mất hẳn hai tay và
     khay dược liệu, đúng phần đáng xem. Xén vuông và hạ tâm xuống 45% thì
     lấy trọn từ mặt tới cân. */
  .gioi-thieu-anh img {
    aspect-ratio: 1 / 1;
    object-position: center 45%;
  }

  /* Lời kể của bác sĩ trong khối "Cách mình làm". Chỉ nghiêng chữ, không đổi
     cỡ hay màu — .lead đã lo phần đó rồi. */
  .loi-ke {
    font-style: italic;
  }

  /* Dòng ký tên dưới đoạn trích. Không nghiêng — để nó tách hẳn khỏi lời kể
     chứ không đọc tiếp như một câu nữa trong ngoặc kép. */
  .ky-ten {
    margin-top: 14px;
    font-family: "Be Vietnam Pro", system-ui, sans-serif;
    font-weight: 600;
    color: var(--primary);
  }

  /* Thẻ món: chỉ có ảnh và tên, nên không dùng .info-card (thẻ đó có nền
     trắng và padding dày, để trống một mảng lớn khi không có chữ bên trong). */
  .mon {
    /* Cột dọc để phần tên giãn ra lấp nốt chiều cao thừa: tên dài xuống hai
       dòng làm thẻ đó cao hơn, lưới kéo mấy thẻ kia cao bằng, và nếu tên
       không giãn thì mấy thẻ kia hở một khoảng trắng dưới đáy. */
    display: flex;
    flex-direction: column;
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--shadow-card);
    background: #fff;
    /* Mốc cho nhãn "Bán chạy" đặt tuyệt đối lên góc ảnh. */
    position: relative;
    /* Cả thẻ là một liên kết sang trang chi tiết — bỏ gạch chân và giữ màu
       chữ như cũ, chỉ nhích lên khi rê chuột để biết là bấm được. */
    color: inherit;
    text-decoration: none;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .mon:hover {
    transform: translateY(-3px);
    box-shadow: 0 12px 28px rgba(0, 0, 0, 0.13);
  }

  /* Nhãn góc ảnh. Đặt đè lên ảnh chứ không chen thêm một dòng dưới tên: thẻ
     chỉ có ảnh và tên, thêm dòng nữa là mấy thẻ không có nhãn bị hụt so với
     thẻ có nhãn. */
  /* Ô thay ảnh cho món chưa có ảnh chụp. Cùng khổ 3:4 với thẻ có ảnh để lưới
     không so le, nền nhạt và icon to ở giữa cho biết là còn thiếu ảnh chứ
     không phải ảnh hỏng. */
  .mon-chua-anh {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    aspect-ratio: 3 / 4;
    background: #f2f5fb;
    color: var(--primary);
    opacity: 0.55;
  }

  .nhan-ban-chay {
    position: absolute;
    top: 12px;
    left: 12px;
    z-index: 1;
    padding: 5px 12px;
    border-radius: 999px;
    background: var(--primary);
    color: #fff;
    font-family: "Be Vietnam Pro", system-ui, sans-serif;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.01em;
    /* Ảnh sản phẩm chỗ sáng chỗ tối, đổ bóng để chữ trắng không chìm mất
       khi nhãn rơi đúng vùng sáng. */
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.25);
  }
  .mon img {
    display: block;
    width: 100%;
    /* Khổ DỌC. Từng để ngang 16/10 và bị cắt cụt gần hết: ảnh gốc hầu như
       đều chụp dọc (chai cồn, túi bột, xấp thang), xén ngang thì chỉ còn
       một dải giữa, nhìn không ra là sản phẩm gì.
       Cùng một khổ cho cả hai hàng — thẻ nổi bật to hơn là vì ô của nó rộng
       hơn, không phải vì ảnh xén khác đi. */
    aspect-ratio: 3 / 4;
    object-fit: cover;
    background: #f1f1f1;
  }
  .mon-ten {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    margin: 0;
    padding: 16px 14px;
    font-family: "Be Vietnam Pro", system-ui, sans-serif;
    font-weight: 600;
    color: var(--primary);
    text-align: center;
  }
  /* Lưới ba cột cho cả năm món. Năm món trên ba cột thành 3 + 2, ô cuối
     hàng dưới để trống — chấp nhận, đổi lại mọi thẻ cùng một cỡ. */
  .luoi-mon {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }
  @media (max-width: 960px) {
    .luoi-mon {
      grid-template-columns: repeat(2, 1fr);
      gap: 16px;
    }
  }
  @media (max-width: 520px) {
    .luoi-mon {
      grid-template-columns: 1fr;
    }
  }

</style>
