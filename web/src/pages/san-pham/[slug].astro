---
// Trang chi tiết từng sản phẩm: /san-pham/<slug>
//
// Nội dung KHÔNG nằm ở đây — tên, ảnh và toàn bộ chữ đọc từ
// data/san-pham.mjs. Sửa chữ thì sửa file đó.
//
// Khuôn ĐÚNG BA MỤC, không hơn: Điểm đặc biệt → Công dụng → Phù hợp với.
// Mục nào để mảng rỗng thì trang bỏ hẳn, không in ra một tiêu đề trống.
//
// Từng có thêm mục "Lưu ý" ở cuối, chủ site đã bỏ. Đừng thêm lại.
import Trang from "../../layouts/Trang.astro";
import DuongDan from "../../components/DuongDan.astro";
import ProductGrid from "../../components/ProductGrid.astro";
import { SAN_PHAM, CHU_NUT_TU_VAN, CHU_NUT_MUA, moTaAnh } from "../../data/san-pham.mjs";
import { GOI_DIEN } from "../../data/thong-tin.mjs";
import {
  Leaf,
  Footprints,
  Droplets,
  BottleWine,
  FlaskConical,
  Flower2,
} from "@lucide/astro";

// Khai từng icon một chứ không nhập cả bộ Lucide — nhập cả bộ là kéo hơn
// 1800 icon vào lúc dựng.
const ICON = {
  Leaf,
  Footprints,
  Droplets,
  BottleWine,
  FlaskConical,
  Flower2,
};

export function getStaticPaths() {
  return SAN_PHAM.map((mon) => ({ params: { slug: mon.slug }, props: { mon } }));
}

const { mon } = Astro.props;
const Icon = ICON[mon.icon];

// Ảnh đại diện luôn đứng đầu album, khỏi phải khai lại nó trong mảng album
// của từng món — khai hai lần là có ngày hai chỗ lệch nhau. Món chưa có ảnh
// nào thì album rỗng, trang hiện ô icon thay chỗ.
const anh_album = [
  ...(mon.anh ? [{ anh: mon.anh, alt: mon.anh_alt }] : []),
  ...(mon.album ?? []),
];

// Ảnh hiện khi chia sẻ link lên Facebook/Zalo. Món chưa có ảnh thì để
// undefined cho Trang.astro dùng ảnh chia sẻ chung của site — truyền
// "assets/img/undefined" là thẻ og:image trỏ vào file không tồn tại, link
// chia sẻ hiện trơ không ảnh mà trên trang chẳng có dấu hiệu gì.
const anh_chia_se = mon.anh ? "assets/img/" + mon.anh : undefined;

/**
 * Bản ĐẦY ĐỦ của một ảnh: giữ nguyên khung hình gốc, không bị xén vuông.
 * Trang hiện bản vuông cho lưới đều, còn bấm vào thì lightbox mở bản này —
 * thấy trọn sản phẩm chứ không phải phần đã cắt.
 *
 * Quy ước tên: product-x.jpg (vuông) ↔ product-x-full.jpg (đầy đủ). Thêm
 * ảnh sản phẩm mới thì phải sinh cả hai, nếu không lightbox trỏ vào file
 * không có thật và bấm ảnh ra khung trắng.
 */
// Mô tả ảnh dùng chung cho mọi ảnh của món này — khuôn đặt ở san-pham.mjs.
const mo_ta_anh = moTaAnh(mon.ten);

const banDayDu = (ten) => "/assets/img/" + ten.replace(/\.jpg$/i, "-full.jpg");

// Các mục nội dung. Gom thành mảng để trang chỉ duyệt một vòng, thêm mục
// mới chỉ phải thêm một dòng ở đây.
const MUC = [
  { tieu_de: "Điểm đặc biệt", icon: "ic-award", dong: mon.diem_dac_biet },
  { tieu_de: "Công dụng", icon: "ic-activity", dong: mon.cong_dung },
  { tieu_de: "Phù hợp với", icon: "ic-run", dong: mon.doi_tuong },
].filter((m) => m.dong?.length > 0);

// Các món khác, cho khối cuối trang. Loại chính món đang mở ra.
const mon_khac = SAN_PHAM.filter((m) => m.slug !== mon.slug);
---

<Trang
  tieu_de={mon.ten}
  mo_ta={mon.mo_ta_seo}
  duong_dan={"san-pham/" + mon.slug}
  anh={anh_chia_se}
  anh_alt={mo_ta_anh}
  loai_trang="service"
  lop_body="subpage"
  scripts={["thong-tin.js", "seo-schema.js", "lightbox.js", "sticky-cta.js"]}
>
  <section class="section cv-hero">
    <div class="container">
      <DuongDan giua={[{ chu: "Sản phẩm", dia_chi: "/san-pham" }]} hien_tai={mon.ten} />
      <h1>{Icon && <Icon size={30} stroke-width={1.7} />} {mon.ten}</h1>
    </div>
  </section>

  <section class="section chi-tiet">
    <div class="container chi-tiet-grid">
      {/* ——— Album: một ảnh to, dải ảnh nhỏ bên dưới ——— */}
      <div class="album">
        <div class="album-lon">
          {anh_album.length > 0 ? (
            <img
              id="anhLon"
              src={"/assets/img/" + anh_album[0].anh}
              data-full={banDayDu(anh_album[0].anh)}
              data-lightbox-skip
              alt={mo_ta_anh}
              width="1000"
              height="1000"
            />
          ) : (
            /* Món chưa chụp được ảnh nào — hiện icon trên nền nhạt, giữ đúng
               khổ để trang không hụt một mảng. Thêm ảnh trong san-pham.mjs
               là khối này tự biến mất. */
            <span class="album-noimg">
              {Icon && <Icon size={88} stroke-width={1.2} />}
            </span>
          )}
        </div>
        {anh_album.length > 1 && (
          <div class="album-nho" role="list">
            {anh_album.map((a, i) => (
              <button
                class:list={["album-nut", i === 0 && "dang-chon"]}
                type="button"
                role="listitem"
                data-anh={"/assets/img/" + a.anh}
                data-full={banDayDu(a.anh)}
                data-alt={mo_ta_anh}
                aria-label={"Xem ảnh: " + a.alt}
              >
                {/* data-full phải đặt trên chính thẻ <img>: lightbox.js đọc thuộc
                    tính của ảnh, không đọc của nút bọc ngoài. Thiếu nó thì
                    lightbox mở bản vuông đã xén chứ không phải bản đầy đủ. */}
                <img
                  src={"/assets/img/" + a.anh}
                  data-full={banDayDu(a.anh)}
                  alt={mo_ta_anh}
                  loading="lazy"
                />
              </button>
            ))}
          </div>
        )}
      </div>

      {/* ——— Chữ và hai nút ——— */}
      <div class="chi-tiet-chu">
        {mon.gioi_thieu && <p class="lead">{mon.gioi_thieu}</p>}

        {MUC.map((m) => (
          <div class="muc">
            <h2><svg class="icon icon-sm"><use href={"#" + m.icon}/></svg> {m.tieu_de}</h2>
            {/* Dùng <ul> thường chứ không phải .list-check: chủ site chốt
                gạch đầu dòng tròn đen bình thường, không phải chấm xanh. */}
            <ul class="bullet-list">
              {m.dong.map((d) => <li>{d}</li>)}
            </ul>
          </div>
        ))}

        {MUC.length === 0 && !mon.gioi_thieu && (
          <p class="lead">
            Món này mình chưa kịp viết phần giới thiệu lên trang. Bạn cứ nhắn Zalo, mình nói rõ
            thành phần và cách dùng cho đúng với tình trạng của bạn.
          </p>
        )}

        <div class="chi-tiet-nut">
          <a class="btn btn-primary btn-icon" data-tt-href="zalo">
            {CHU_NUT_TU_VAN} <svg class="icon icon-sm"><use href="#ic-arrow"/></svg>
          </a>
          {/* Không in số điện thoại lên nút — chủ site chốt. Số vẫn nằm
              trong href nên bấm là gọi được, và chân trang vẫn hiện số. */}
          <a class="btn btn-outline btn-icon" href={GOI_DIEN}>
            <svg class="icon icon-sm"><use href="#ic-chat"/></svg> {CHU_NUT_MUA}
          </a>
        </div>
        <p class="chi-tiet-ghi-chu">
          Đây là chế phẩm hỗ trợ, không thay thế cho việc khám và dùng thuốc theo chỉ định.
        </p>
      </div>
    </div>
  </section>

  {/* Không có khối địa chỉ / giờ đón khách ở đây: chủ site đã bỏ. Hai thứ
      đó vẫn nằm sẵn ở chân trang trên mọi trang. Đừng thêm lại.

      Cũng KHÔNG có khối "Các dịch vụ khác mình cung cấp": người đang xem
      một món hàng thì cái đáng mời xem tiếp là món khác, không phải dịch
      vụ khám chữa. */}
  <section class="section section-alt">
    <div class="container">
      <div class="section-title text-center">
        <p class="section-label">Xem thêm</p>
        <h2>Các sản phẩm khác</h2>
        <div class="divider mx-auto"></div>
      </div>
      <ProductGrid items={mon_khac} />
    </div>
  </section>
</Trang>

<script>
  // ——— Album: ảnh nhỏ đổi ảnh to, ảnh to mở lightbox ———
  //
  // Ba việc phải khớp nhau, sai một cái là hỏng một cái khác:
  //
  //  1. Bấm ảnh NHỎ  → chỉ đổi ảnh to, KHÔNG mở lightbox.
  //  2. Bấm ảnh TO   → mở lightbox đúng tấm đang xem.
  //  3. Trong lightbox, nút tới/lui phải chạy hết cả album.
  //
  // Cách làm: danh sách của lightbox chính là dải ảnh nhỏ (lightbox.js tự
  // gom mọi <img> trong section). Ảnh to bị loại khỏi danh sách bằng
  // data-lightbox-skip, vì nó chỉ là bản phóng của một trong mấy ảnh nhỏ —
  // để cả hai vào thì lightbox có hai lần cùng một tấm.
  //
  // Việc (1): lightbox.js gắn sự kiện thẳng vào từng <img>, mà sự kiện ở
  // chính thẻ đích luôn chạy TRƯỚC sự kiện của thẻ cha. Nên muốn chặn nó
  // phải bắt ở pha CAPTURE trên thẻ bọc ngoài rồi stopPropagation — lúc đó
  // sự kiện chưa kịp xuống tới <img>.
  //
  // Việc (2): ảnh to không tự mở được (đã bị loại), nên nó bấm hộ vào ảnh
  // nhỏ đang chọn. Lúc bấm hộ phải tạm tắt cái chặn ở trên, nếu không
  // chính cú bấm hộ đó cũng bị chặn nốt.
  const anh_lon = document.getElementById("anhLon");
  const dai_anh = document.querySelector(".album-nho");
  const nut = Array.from(document.querySelectorAll(".album-nut"));

  // Món chưa có ảnh, hoặc chỉ có một ảnh nên không có dải ảnh nhỏ.
  if (anh_lon && dai_anh) {
    let dang_bam_ho = false;

    dai_anh.addEventListener(
      "click",
      (su_kien) => {
        if (dang_bam_ho) return;
        const n = su_kien.target.closest(".album-nut");
        if (!n) return;
        su_kien.stopPropagation();
        su_kien.preventDefault();
        anh_lon.src = n.dataset.anh;
        // Đổi cả data-full, nếu không bấm ảnh to lại ra bản đầy đủ của
        // tấm trước đó.
        anh_lon.dataset.full = n.dataset.full;
        anh_lon.alt = n.dataset.alt;
        nut.forEach((k) => k.classList.remove("dang-chon"));
        n.classList.add("dang-chon");
      },
      true
    );

    anh_lon.addEventListener("click", () => {
      const dang_chon = document.querySelector(".album-nut.dang-chon") || nut[0];
      const anh_nho = dang_chon && dang_chon.querySelector("img");
      if (!anh_nho) return;
      dang_bam_ho = true;
      anh_nho.click();
      dang_bam_ho = false;
    });
  }
</script>

<style>
  /* Chỉ trang này dùng nên để trong <style> của trang, không thêm vào
     style.css. Astro tự giới hạn phạm vi khối này cho riêng trang. */

  /* Bỏ khoảng trống trên. Ngay phía trên là khối tiêu đề trang, vốn đã có
     khoảng cách dưới của nó — hai khoảng cộng lại đẩy ảnh xuống gần hết
     màn hình đầu tiên, người đọc phải cuộn mới thấy sản phẩm. */
  .chi-tiet {
    padding-top: 0;
  }

  h1 .lucide {
    vertical-align: -0.12em;
    margin-right: 6px;
    color: var(--primary);
  }

  /* Ảnh bên trái, chữ bên phải. Cột ảnh hẹp hơn vì ảnh khổ dọc, để rộng
     bằng nhau thì ảnh cao vống lên còn cột chữ hở một mảng trắng. */
  .chi-tiet-grid {
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    gap: 48px;
    align-items: start;
  }

  .album-lon img {
    display: block;
    width: 100%;
    /* Bắt buộc có height:auto. Thẻ <img> mang sẵn width/height 1000x1000 để
       trình duyệt chừa chỗ trước khi ảnh tải xong (khỏi giật layout), nhưng
       chừng nào chiều cao còn lấy từ thuộc tính đó thì aspect-ratio không
       có tác dụng — ảnh bị kéo cao đúng 1000px thay vì cao bằng bề ngang ô. */
    height: auto;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    border-radius: var(--radius);
    box-shadow: var(--shadow-card);
    background: #f1f1f1;
  }

  /* Dải ảnh nhỏ. Bốn ô một hàng, ảnh thừa xuống hàng sau — không cuộn
     ngang, vì dải cuộn ngang trên máy tính hay bị bỏ sót. */
  .album-noimg {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    aspect-ratio: 1 / 1;
    border-radius: var(--radius);
    background: #f2f5fb;
    color: var(--primary);
    opacity: 0.5;
  }

  .album-nho {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 10px;
    margin-top: 12px;
  }
  .album-nut {
    padding: 0;
    border: 2px solid transparent;
    border-radius: 10px;
    overflow: hidden;
    background: none;
    cursor: pointer;
    line-height: 0;
    transition: border-color 0.2s ease;
  }
  .album-nut img {
    width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    background: #f1f1f1;
  }
  .album-nut:hover { border-color: var(--primary); }
  .album-nut.dang-chon { border-color: var(--primary); }

  .muc { margin-bottom: 32px; }

  /* Gạch đầu dòng tròn đen bình thường. Phải khai cả list-style lẫn padding:
     style.css của site đặt ul { list-style: none } và bộ reset ở đầu file
     xoá sạch padding, nên không khai lại thì danh sách mất hết chấm. */
  .bullet-list {
    margin: 0;
    padding-left: 22px;
    list-style: disc;
  }
  .bullet-list li {
    margin-bottom: 8px;
  }
  .bullet-list li::marker {
    color: #1f2937;
  }

  .muc h2 {
    font-size: 1.25rem;
    color: var(--primary);
    margin-bottom: 14px;
  }
  .muc h2 .icon { vertical-align: -0.15em; margin-right: 6px; }

  .chi-tiet-nut {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 32px;
  }
  .chi-tiet-ghi-chu {
    margin-top: 16px;
    font-size: 0.9rem;
    color: var(--muted, #6b7280);
  }

  /* ——— Điện thoại ——— */
  @media (max-width: 720px) {
    /* Hai nút dính đáy màn hình thay vì nằm lẫn trong bài. Không nhân bản
       nút bằng JS như sticky-cta.js — chính hai nút này chuyển xuống, nên
       không có chuyện hai bản nút lệch chữ nhau.
       sticky-cta.js không dựng gì trên trang này vì nó nhân bản từ
       .cv-hero .offer-actions, mà hero của trang sản phẩm không có nút. */
    .chi-tiet-nut {
      position: fixed;
      left: 0;
      right: 0;
      bottom: 0;
      z-index: 95;
      margin: 0;
      padding: 10px 16px;
      padding-bottom: calc(10px + env(safe-area-inset-bottom, 0px));
      gap: 10px;
      background: rgba(255, 255, 255, 0.96);
      backdrop-filter: blur(8px);
      box-shadow: 0 -2px 16px rgba(0, 42, 106, 0.12);
    }
    /* Hai nút chia đôi bề ngang, xếp ngang chứ không chồng lên nhau —
       chồng thì thanh cao 110px, che mất một phần ba màn hình. */
    .chi-tiet-nut .btn {
      flex: 1;
      justify-content: center;
      padding-left: 12px;
      padding-right: 12px;
      white-space: nowrap;
    }
    /* Chừa chỗ để thanh không đè lên cuối trang. */
    :global(.site-footer) {
      padding-bottom: 76px;
    }
  }

  @media (max-width: 880px) {
    .chi-tiet-grid {
      grid-template-columns: 1fr;
      gap: 32px;
    }
    /* Trên điện thoại ảnh dọc chiếm gần trọn màn hình, bó lại cho vừa mắt. */
    .album-lon { max-width: 420px; margin: 0 auto; }
    .album-nho { max-width: 420px; margin-left: auto; margin-right: auto; }
  }
</style>
