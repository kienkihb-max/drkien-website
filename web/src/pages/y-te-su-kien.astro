---
// Trang này chuyển từ y-te-su-kien.html của site tĩnh cũ.
// Toàn bộ thẻ SEO nay do layouts/Trang.astro sinh — sửa tiêu đề hay mô tả
// thì sửa ở mấy dòng thuộc tính ngay dưới đây, đừng thêm thẻ meta vào thân.
import Trang from "../layouts/Trang.astro";
import DuongDan from "../components/DuongDan.astro";
---

<Trang
  tieu_de="Y tế sự kiện thể thao — Bác sĩ Lê Trung Kiên"
  mo_ta="Bác sĩ Lê Trung Kiên đồng hành y tế tại các giải chạy, giải đấu thể thao: sơ cứu chấn thương, tư vấn phòng ngừa, xử trí cấp cứu tại chỗ."
  duong_dan="y-te-su-kien"
  anh="assets/img/sports-event-team.jpg"
  anh_alt="Tổ y tế đồng hành tại giải đấu thể thao"
  loai_trang="service"
  lop_body="subpage"
  scripts={["thong-tin.js","seo-schema.js","service-cards.js","sticky-cta.js"]}
>
<section class="section cv-hero">
    <div class="container">
      <DuongDan hien_tai="Y tế sự kiện thể thao" />
      <h1>Bác sĩ tại các sự kiện, giải đấu thể thao</h1>
      <p class="lead">
        Mình đồng hành y tế tại các sự kiện thể thao, văn hóa — từ giải chạy, giải đấu phong trào
        đến concert, sự kiện đông người — với tư vấn phòng ngừa chấn thương, xử trí cấp cứu tại
        chỗ và hỗ trợ y tế trực tiếp cho vận động viên, khán giả.
      </p>
      <div class="offer-actions">
        <a class="btn btn-primary btn-icon" data-tt-href="zalo">
          Liên hệ hợp tác sự kiện <svg class="icon icon-sm"><use href="#ic-arrow"/></svg>
        </a>
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <div class="section-title text-center">
        <p class="section-label">Sự kiện đã tham gia</p>
        <h2>Một số sự kiện đã đồng hành y tế</h2>
        <div class="divider mx-auto"></div>
      </div>
      <div class="events-featured-grid">
        <div class="event-card event-card-featured">
          <span class="event-badge">Nổi bật</span>
          <div class="event-img"><img src="/assets/img/event-seagames31-doi-y-te.jpg" alt="Đội đáp ứng Y tế cùng vali thuốc và dụng cụ cấp cứu tại SEA Games 31, Việt Nam 2022" loading="lazy"></div>
          <h3>Y tế SEA Games 31</h3>
          <p>Đội trưởng đội đáp ứng Y tế tại SEA Games 31, Việt Nam, 2022.</p>
        </div>
        <div class="event-card event-card-featured">
          <span class="event-badge">Nổi bật</span>
          <div class="event-img"><img src="/assets/img/event-daihoi-tdtt-thudo-2025.jpg" alt="Đội y tế Lễ khai mạc Đại hội Thể dục Thể thao Thủ đô lần thứ XI năm 2025, Hà Nội 15/12/2025" loading="lazy"></div>
          <h3>Đại hội Thể dục Thể thao Thủ đô lần thứ XI, 2025</h3>
          <p>Đội y tế Lễ khai mạc Đại hội Thể dục Thể thao Thủ đô lần thứ XI năm 2025 — Hà Nội, 15/12/2025.</p>
        </div>
      </div>
      <div class="events-grid">
        <div class="event-card">
          <div class="event-img"><img src="/assets/img/event-anh-trai-say-hi-2025.jpg" alt="Hỗ trợ y tế cho khán giả tại concert Anh Trai Say Hi 2025" loading="lazy"></div>
          <h3>Concert Anh Trai Say Hi 2025</h3>
          <p>Hỗ trợ y tế, xử trí tại chỗ cho khán giả tại đêm diễn Anh Trai Say Hi 2025.</p>
        </div>
        <div class="event-card">
          <div class="event-img"><img src="/assets/img/event-pickleball-fsb-2026.jpg" alt="Đảm bảo công tác Y tế tại giải Pickleball FSB Cup 2026" loading="lazy"></div>
          <h3>Giải Pickleball FSB Cup 2026</h3>
          <p>Đảm bảo công tác Y tế tại giải Pickleball phong trào FSB Cup 2026.</p>
        </div>
        <div class="event-card">
          <div class="event-img"><img src="/assets/img/event-run-to-future.jpg" alt="Đảm bảo công tác Y tế tại giải chạy Run To Future, kỷ niệm thành lập Dasan Việt Nam, 12/4/2025" loading="lazy"></div>
          <h3>Giải chạy Run To Future</h3>
          <p>Đảm bảo công tác Y tế tại giải chạy Run To Future — kỷ niệm thành lập Dasan Việt Nam, 12/4/2025.</p>
        </div>
        <div class="event-card">
          <div class="event-img"><img src="/assets/img/event-phao-hoa-my-dinh.jpg" alt="Đảm bảo y tế trận địa pháo hoa khu vực Mỹ Đình nhân dịp Tết Nguyên Đán" loading="lazy"></div>
          <h3>Trận địa pháo hoa Mỹ Đình</h3>
          <p>Đảm bảo y tế tại trận địa bắn pháo hoa khu vực Mỹ Đình nhân dịp Tết Nguyên Đán.</p>
        </div>
        <div class="event-card">
          <div class="event-img"><img src="/assets/img/event-roller-sports-my-way-2026.jpg" alt="Đảm bảo công tác Y tế tại giải đua Roller Sports My Way 2026, Câu lạc bộ Patin My Way" loading="lazy"></div>
          <h3>Roller Sports My Way 2026</h3>
          <p>Đảm bảo công tác Y tế tại giải đua Roller Sports My Way 2026 — Câu lạc bộ Patin My Way.</p>
        </div>
        <div class="event-card">
          <div class="event-img"><img src="/assets/img/event-fsb-cup-football-2025.webp" alt="Đảm bảo công tác Y tế, sơ cứu chấn thương cầu thủ tại giải bóng đá FSB Cup 2025" loading="lazy"></div>
          <h3>Giải bóng đá FSB Cup 2025</h3>
          <p>Đảm bảo công tác Y tế, sơ cứu chấn thương cầu thủ tại giải bóng đá FSB Cup 2025.</p>
        </div>
      </div>
      <p class="cv-link-wrap">
        <a class="btn btn-primary btn-icon" data-tt-href="zalo">
          Liên hệ hợp tác sự kiện <svg class="icon icon-sm"><use href="#ic-arrow"/></svg>
        </a>
      </p>
    </div>
  </section>

  <!-- Nội dung do service-cards.js dựng — sửa danh sách dịch vụ trong file đó -->
  <section class="section service-related"></section>
</Trang>
